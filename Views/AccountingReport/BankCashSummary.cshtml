@model BankCashAccountSummaryViewModel
@{
    ViewData["Title"] = "Bank & Cash Account Summary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bank &amp; Cash Account Summary</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Accounting Reports</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Opening</div><div class="fs-5 fw-bold">@Model.TotalOpening.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Receipts</div><div class="fs-5 fw-bold">@Model.TotalReceipts.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Payments</div><div class="fs-5 fw-bold">@Model.TotalPayments.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Closing</div><div class="fs-5 fw-bold">@Model.TotalClosing.ToString("N2")</div></div></div></div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Account</th><th class="text-end">Opening</th><th class="text-end">Receipts</th>
                <th class="text-end">Payments</th><th class="text-end">Closing</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Account</td><td class="text-end">@r.Opening.ToString("N2")</td><td class="text-end">@r.Receipts.ToString("N2")</td>
                    <td class="text-end">@r.Payments.ToString("N2")</td><td class="text-end">@r.Closing.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">No accounts</td></tr>
            }
        </tbody>
    </table>
</div>