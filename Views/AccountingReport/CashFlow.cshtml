@model CashFlowViewModel
@{
    ViewData["Title"] = "Cash Flow Statement";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Cash Flow Statement (Indirect)</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Accounting Reports</a>
</div>

<form method="get" asp-action="CashFlow" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm mb-3">
    <div class="card-header"><strong>Operating Activities</strong></div>
    <table class="table table-sm mb-0 align-middle">
        <tbody>
            @foreach (var r in Model.Operating)
            {
                <tr><td>@r.Label</td><td class="text-end">@r.Amount.ToString("N2")</td></tr>
            }
            <tr class="fw-bold"><td>Net cash from operating</td><td class="text-end">@Model.OperatingNet.ToString("N2")</td></tr>
            @if (Model.Operating.Count == 0)
            {
                <tr><td colspan="2" class="text-center text-muted">No data</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header"><strong>Investing Activities</strong></div>
    <table class="table table-sm mb-0 align-middle">
        <tbody>
            @foreach (var r in Model.Investing)
            {
                <tr><td>@r.Label</td><td class="text-end">@r.Amount.ToString("N2")</td></tr>
            }
            <tr class="fw-bold"><td>Net cash from investing</td><td class="text-end">@Model.InvestingNet.ToString("N2")</td></tr>
            @if (Model.Investing.Count == 0)
            {
                <tr><td colspan="2" class="text-center text-muted">No data</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Financing.Count > 0)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header"><strong>Financing Activities</strong></div>
        <table class="table table-sm mb-0 align-middle">
            <tbody>
                @foreach (var r in Model.Financing)
                {
                    <tr><td>@r.Label</td><td class="text-end">@r.Amount.ToString("N2")</td></tr>
                }
                <tr class="fw-bold"><td>Net cash from financing</td><td class="text-end">@Model.FinancingNet.ToString("N2")</td></tr>
            </tbody>
        </table>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body d-flex justify-content-end fw-bold gap-4">
        <span>Opening Cash: @Model.OpeningCash.ToString("N2")</span>
        <span>Net Change: @Model.NetChange.ToString("N2")</span>
        <span>Closing Cash: @Model.ClosingCash.ToString("N2")</span>
    </div>
</div>