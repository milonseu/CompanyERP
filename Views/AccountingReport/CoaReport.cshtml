@model CoaReportViewModel
@{
    ViewData["Title"] = "COA Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Chart of Accounts Report</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Accounting Reports</a>
</div>

<form method="get" asp-action="CoaReport" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Opening</div><div class="fs-5 fw-bold">@Model.TotalOpening.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Debit</div><div class="fs-5 fw-bold">@Model.TotalDebit.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Credit</div><div class="fs-5 fw-bold">@Model.TotalCredit.ToString("N2")</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Total Closing</div><div class="fs-5 fw-bold">@Model.TotalClosing.ToString("N2")</div></div></div></div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Code</th><th>Account</th><th>Type</th>
                    <th class="text-end">Opening</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Closing</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.AccountCode</td><td>@r.AccountName</td><td>@r.AccountType</td>
                        <td class="text-end">@r.Opening.ToString("N2")</td><td class="text-end">@r.Debit.ToString("N2")</td>
                        <td class="text-end">@r.Credit.ToString("N2")</td><td class="text-end">@r.Closing.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted">No accounts</td></tr>
                }
                <tr class="fw-bold">
                    <td colspan="3" class="text-end">Total</td>
                    <td class="text-end">@Model.TotalOpening.ToString("N2")</td>
                    <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                    <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                    <td class="text-end">@Model.TotalClosing.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>