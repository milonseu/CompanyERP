@model GeneralJournalViewModel
@{
    ViewData["Title"] = "General Journal";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">General Journal</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Accounting Reports</a>
</div>

<form method="get" asp-action="GeneralJournal" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Branch</label>
            <select name="branchId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var b in ViewBag.Branches)
                {
                    <option value="@b.Value" selected="@(b.Value == Model.BranchId.ToString() ? "selected" : null)">@b.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Date</th><th>Entry No</th><th>Description</th><th>Module / Ref</th>
                    <th>Account</th><th class="text-end">Debit</th><th class="text-end">Credit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("dd-MMM-yyyy")</td>
                        <td>@r.EntryNo</td>
                        <td>@r.Description</td>
                        <td>@r.SourceModule @(string.IsNullOrEmpty(r.SourceReference) ? "" : $"/ {r.SourceReference}")</td>
                        <td>@r.AccountCode - @r.AccountName</td>
                        <td class="text-end">@(r.Debit > 0 ? r.Debit.ToString("N2") : "")</td>
                        <td class="text-end">@(r.Credit > 0 ? r.Credit.ToString("N2") : "")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted">No journal entries in range</td></tr>
                }
                <tr class="fw-bold">
                    <td colspan="5" class="text-end">Total</td>
                    <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                    <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>