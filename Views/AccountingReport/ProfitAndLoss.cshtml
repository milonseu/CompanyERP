@model ProfitAndLossViewModel
@{
    ViewData["Title"] = "Profit & Loss";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Profit &amp; Loss</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Reports</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input type="date" name="fromDate" class="form-control" value="@(Context.Request.Query["fromDate"])" /></div>
    <div class="col-md-3"><input type="date" name="toDate" class="form-control" value="@(Context.Request.Query["toDate"])" /></div>
    <div class="col-md-3"><button class="btn btn-outline-primary" type="submit">Filter</button></div>
</form>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Revenue</h2>
                <table class="table table-sm mb-0">
                    @foreach (var r in Model.Revenues)
                    {
                        var indent = r.Depth * 16;
                        <tr class="@(r.IsSubtotal ? "table-light" : "")">
                            <td style="padding-left: @(10 + indent)px;">
                                @if (r.Depth > 0)
                                {
                                    <span class="text-muted me-1">@(r.IsSubtotal ? "├─" : "└─")</span>
                                }
                                <span class="@(r.IsSubtotal ? "fw-bold" : "")">@r.AccountCode - @r.AccountName</span>
                            </td>
                            <td class="text-end @(r.IsSubtotal ? "fw-bold" : "")">@r.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="fw-bold"><td>Total Revenue</td><td class="text-end">@Model.TotalRevenue.ToString("N2")</td></tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Expenses</h2>
                <table class="table table-sm mb-0">
                    @foreach (var e in Model.Expenses)
                    {
                        var indent = e.Depth * 16;
                        <tr class="@(e.IsSubtotal ? "table-light" : "")">
                            <td style="padding-left: @(10 + indent)px;">
                                @if (e.Depth > 0)
                                {
                                    <span class="text-muted me-1">@(e.IsSubtotal ? "├─" : "└─")</span>
                                }
                                <span class="@(e.IsSubtotal ? "fw-bold" : "")">@e.AccountCode - @e.AccountName</span>
                            </td>
                            <td class="text-end @(e.IsSubtotal ? "fw-bold" : "")">@e.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="fw-bold"><td>Total Expenses</td><td class="text-end">@Model.TotalExpense.ToString("N2")</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <span class="fw-bold h5">Net Profit / (Loss)</span>
            <span class="@(Model.NetProfit >= 0 ? "text-success" : "text-danger") fw-bold h5">@Model.NetProfit.ToString("N2")</span>
        </div>
    </div>
</div>