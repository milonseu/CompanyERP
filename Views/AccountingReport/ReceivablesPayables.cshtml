@model ReceivablesPayablesViewModel
@{
    ViewData["Title"] = "Accounts Receivable / Payable";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Accounts Receivable / Payable</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Reports</a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Accounts Receivable</h2>
                <table class="table table-sm mb-0">
                    <thead><tr><th>Account</th><th class="text-end">Opening</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Closing</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Receivables)
                        {
                            <tr><td>@r.AccountCode - @r.AccountName</td><td class="text-end">@r.Opening.ToString("N2")</td><td class="text-end">@r.Debit.ToString("N2")</td><td class="text-end">@r.Credit.ToString("N2")</td><td class="text-end">@r.Closing.ToString("N2")</td></tr>
                        }
                    </tbody>
                    <tfoot><tr class="fw-bold"><td>Total Receivables</td><td></td><td></td><td></td><td class="text-end">@Model.TotalReceivables.ToString("N2")</td></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Accounts Payable</h2>
                <table class="table table-sm mb-0">
                    <thead><tr><th>Account</th><th class="text-end">Opening</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Closing</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payables)
                        {
                            <tr><td>@p.AccountCode - @p.AccountName</td><td class="text-end">@p.Opening.ToString("N2")</td><td class="text-end">@p.Debit.ToString("N2")</td><td class="text-end">@p.Credit.ToString("N2")</td><td class="text-end">@p.Closing.ToString("N2")</td></tr>
                        }
                    </tbody>
                    <tfoot><tr class="fw-bold"><td>Total Payables</td><td></td><td></td><td></td><td class="text-end">@Model.TotalPayables.ToString("N2")</td></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
</div>