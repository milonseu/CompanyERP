@model AssetRegister
@{
    ViewData["Title"] = "Register Asset";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Register Asset</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <h2 class="h6 mb-2">Asset Details</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select">
                        <option value="">-- Select Company --</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssetNo" class="form-label"></label>
                    <input asp-for="AssetNo" class="form-control" readonly />
                    <span asp-validation-for="AssetNo" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BranchId" class="form-label"></label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select Branch --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Asset Category</label>
                    <select id="CategorySelect" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssetTypeId" class="form-label"></label>
                    <select asp-for="AssetTypeId" asp-items="ViewBag.Types" class="form-select">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="AssetTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SerialNo" class="form-label"></label>
                    <input asp-for="SerialNo" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PurchaseDate" class="form-label"></label>
                    <input asp-for="PurchaseDate" type="date" class="form-control" />
                    <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Cost" class="form-label"></label>
                    <input asp-for="Cost" class="form-control" />
                    <span asp-validation-for="Cost" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" />
                </div>
            </div>

            <h2 class="h6 mt-4 mb-2">Acquisition Information</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Acquisition Date</label>
                    <input name="acquisition.AcquisitionDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Supplier</label>
                    <select name="acquisition.SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payment Type</label>
                    <select name="acquisition.PaymentType" asp-items="Html.GetEnumSelectList<AcquisitionPaymentType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Amount Paid</label>
                    <input name="acquisition.AmountPaid" class="form-control" value="0" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payment Reference</label>
                    <input name="acquisition.PaymentReference" class="form-control" />
                </div>
                <div class="col-md-4">
                    <div class="form-text mt-4">
                        Depreciation method, useful life and salvage value are taken from the selected asset type. Book value = Cost &minus; Accumulated Depreciation.
                    </div>
                </div>
            </div>

            <input type="hidden" asp-for="Status" />
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const assetsTypes = @Html.Raw(ViewBag.TypesJson);

        function filterTypes() {
            const categoryId = Number(document.getElementById('CategorySelect').value);
            const typeSelect = document.getElementById('AssetTypeId');
            const selected = Number(typeSelect.value);
            typeSelect.innerHTML = '<option value="">-- Select Type --</option>';
            assetsTypes.filter(t => !categoryId || t.AssetCategoryId === categoryId).forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.Id;
                opt.text = t.Name;
                if (t.Id === selected) opt.selected = true;
                typeSelect.appendChild(opt);
            });
        }

        document.getElementById('CategorySelect').addEventListener('change', filterTypes);
    </script>
}