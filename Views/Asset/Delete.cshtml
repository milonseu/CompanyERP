@model AssetRegister
@{
    ViewData["Title"] = "Delete Asset";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Asset</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <p class="text-danger fw-semibold">Are you sure you want to delete this asset?</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Asset No</dt>
            <dd class="col-sm-9">@Model.AssetNo</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Cost</dt>
            <dd class="col-sm-9">@Model.Cost.ToString("N2")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>