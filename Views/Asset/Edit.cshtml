@model AssetRegister
@{
    ViewData["Title"] = "Edit Asset";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit Asset</h1>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to Details</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="AssetNo" class="form-label"></label>
                    <input asp-for="AssetNo" class="form-control" />
                    <span asp-validation-for="AssetNo" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AssetTypeId" class="form-label"></label>
                    <select asp-for="AssetTypeId" asp-items="ViewBag.Types" class="form-select">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="AssetTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BranchId" class="form-label"></label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select Branch --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SerialNo" class="form-label"></label>
                    <input asp-for="SerialNo" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" />
                </div>
            </div>
            <div class="form-text mb-3">
                Cost (@Model.Cost.ToString("N2")), purchase date, useful life and salvage value are locked after depreciation has been posted.
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}