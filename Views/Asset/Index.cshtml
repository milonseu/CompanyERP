@model IEnumerable<AssetRegister>
@{
    ViewData["Title"] = "Asset Register";
    var statusFilter = ViewBag.Statuses?.SelectedValue as AssetStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asset Register</h1>
    <a asp-action="Create" class="btn btn-primary">Register Asset</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="branchId" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- All Branches --</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="status" asp-items="ViewBag.Statuses" class="form-select">
            <option value="">-- All Statuses --</option>
        </select>
    </div>
    <div class="col-md-4">
        <input name="search" class="form-control" placeholder="Search by no / name / serial" value="@Context.Request.Query["search"]" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Asset No</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Branch</th>
                    <th class="text-end">Cost</th>
                    <th class="text-end">Accum. Depr.</th>
                    <th class="text-end">Book Value</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No asset found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AssetNo</td>
                            <td>@item.Name</td>
                            <td>@item.AssetType?.Name</td>
                            <td>@item.Branch?.Name</td>
                            <td class="text-end">@item.Cost.ToString("N2")</td>
                            <td class="text-end">@item.AccumulatedDepreciation.ToString("N2")</td>
                            <td class="text-end fw-semibold">@item.BookValue.ToString("N2")</td>
                            <td>
                                @if (item.Status == AssetStatus.Disposed)
                                {
                                    <span class="badge bg-secondary">Disposed</span>
                                }
                                else if (item.Status == AssetStatus.InMaintenance)
                                {
                                    <span class="badge bg-warning text-dark">In Maintenance</span>
                                }
                                else if (item.Status == AssetStatus.Registered)
                                {
                                    <span class="badge bg-info">Registered</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                @if (item.Status != AssetStatus.Disposed)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                }
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>