@model IEnumerable<AssetDisposal>
@{
    ViewData["Title"] = "Asset Disposals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asset Disposals</h1>
    <a asp-action="Create" class="btn btn-primary">Dispose Asset</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Asset</th>
                    <th>Disposal Date</th>
                    <th class="text-end">Sale Value</th>
                    <th class="text-end">Book Value</th>
                    <th class="text-end">Gain / Loss</th>
                    <th>Result</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No asset disposal found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AssetRegister?.Name</td>
                            <td>@item.DisposalDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">@item.SaleValue.ToString("N2")</td>
                            <td class="text-end">@item.BookValueAtDisposal.ToString("N2")</td>
                            <td class="text-end @(item.GainLossAmount >= 0 ? "text-success" : "text-danger")">
                                @item.GainLossAmount.ToString("N2")
                            </td>
                            <td>
                                @if (item.Result == DisposalResult.Gain)
                                {
                                    <span class="badge bg-success">Gain</span>
                                }
                                else if (item.Result == DisposalResult.Loss)
                                {
                                    <span class="badge bg-danger">Loss</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No gain/loss</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-controller="Asset" asp-action="Details" asp-route-id="@item.AssetRegisterId" class="btn btn-sm btn-outline-secondary">Asset</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>