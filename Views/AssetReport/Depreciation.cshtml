@model DepreciationScheduleViewModel
@{
    ViewData["Title"] = "Depreciation Schedule";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Depreciation Schedule</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Asset Reports</a>
</div>

<form method="get" asp-action="Depreciation" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">From Period (yyyy-MM)</label>
            <input type="month" name="fromPeriod" class="form-control form-control-sm" value="@Model.FromPeriod" />
        </div>
        <div class="col-md-4">
            <label class="form-label">To Period (yyyy-MM)</label>
            <input type="month" name="toPeriod" class="form-control form-control-sm" value="@Model.ToPeriod" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-sm mb-0 align-middle">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Period End</th>
                    <th>Asset No</th>
                    <th>Asset</th>
                    <th class="text-end">Depreciation</th>
                    <th class="text-end">Accumulated After</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.PeriodKey</td>
                        <td>@r.PeriodDate.ToString("dd MMM yyyy")</td>
                        <td>@r.AssetNo</td>
                        <td>@r.Asset</td>
                        <td class="text-end">@r.Amount.ToString("N2")</td>
                        <td class="text-end">@r.AccumulatedAfter.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted">No depreciation posted for the period</td></tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4">Total</td>
                    <td class="text-end">@Model.TotalDepreciation.ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>