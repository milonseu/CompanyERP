@model List<AssetGroupRow>
<table class="table table-sm mb-0 align-middle">
    <thead>
        <tr>
            <th>Group</th><th class="text-end">Count</th><th class="text-end">Cost</th><th class="text-end">Book Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Label</td><td class="text-end">@r.Count</td><td class="text-end">@r.Cost.ToString("N2")</td>
                <td class="text-end">@r.BookValue.ToString("N2")</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted">No assets</td></tr>
        }
    </tbody>
</table>