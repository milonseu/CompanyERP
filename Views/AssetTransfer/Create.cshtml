@model AssetTransfer
@{
    ViewData["Title"] = "New Asset Transfer";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">New Asset Transfer</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AssetRegisterId" class="form-label"></label>
                    <select asp-for="AssetRegisterId" asp-items="ViewBag.Assets" class="form-select">
                        <option value="">-- Select Asset --</option>
                    </select>
                    <span asp-validation-for="AssetRegisterId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TransferDate" class="form-label"></label>
                    <input asp-for="TransferDate" type="date" class="form-control" />
                    <span asp-validation-for="TransferDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FromBranchId" class="form-label"></label>
                    <select asp-for="FromBranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select From Branch --</option>
                    </select>
                    <span asp-validation-for="FromBranchId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ToBranchId" class="form-label"></label>
                    <select asp-for="ToBranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select To Branch --</option>
                    </select>
                    <span asp-validation-for="ToBranchId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FromLocation" class="form-label"></label>
                    <input asp-for="FromLocation" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ToLocation" class="form-label"></label>
                    <input asp-for="ToLocation" class="form-control" />
                </div>
                <div class="col-md-12">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" />
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}