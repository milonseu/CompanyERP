@model IEnumerable<AssetTransfer>
@{
    ViewData["Title"] = "Asset Transfers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asset Transfers</h1>
    <a asp-action="Create" class="btn btn-primary">New Transfer</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Asset</th>
                    <th>From Branch</th>
                    <th>To Branch</th>
                    <th>Location</th>
                    <th>Note</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No transfers recorded.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TransferDate.ToString("dd MMM yyyy")</td>
                            <td>@item.AssetRegister?.Name</td>
                            <td>@(item.FromBranch?.Name ?? "-")</td>
                            <td>@item.ToBranch?.Name</td>
                            <td>@(item.ToLocation ?? item.FromLocation)</td>
                            <td>@item.Note</td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Asset" asp-action="Details" asp-route-id="@item.AssetRegisterId" class="btn btn-sm btn-outline-info">Asset</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>