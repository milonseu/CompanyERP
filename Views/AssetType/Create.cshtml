@model AssetType
@{
    ViewData["Title"] = "New Asset Type";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">New Asset Type</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select">
                        <option value="">-- Select Company --</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssetCategoryId" class="form-label"></label>
                    <select asp-for="AssetCategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="AssetCategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control" placeholder="e.g. CPU" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DepreciationMethod" class="form-label"></label>
                    <select asp-for="DepreciationMethod" asp-items="Html.GetEnumSelectList<AssetDepreciationMethod>()" class="form-select"></select>
                    <span asp-validation-for="DepreciationMethod" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UsefulLifeMonths" class="form-label"></label>
                    <input asp-for="UsefulLifeMonths" class="form-control" />
                    <span asp-validation-for="UsefulLifeMonths" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SalvageValue" class="form-label"></label>
                    <input asp-for="SalvageValue" class="form-control" />
                    <span asp-validation-for="SalvageValue" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}