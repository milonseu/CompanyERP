@model IEnumerable<BankAccount>
@{
    ViewData["Title"] = "Bank Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bank Accounts</h1>
    <a asp-action="Create" class="btn btn-primary">New Bank Account</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Bank</th>
                    <th>Account Name</th>
                    <th>Account No</th>
                    <th>Branch</th>
                    <th class="text-end">Opening Balance</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No bank account found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BankName</td>
                            <td>@item.AccountName</td>
                            <td>@item.AccountNo</td>
                            <td>@item.Branch?.Name</td>
                            <td class="text-end">@item.OpeningBalance.ToString("N2")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>