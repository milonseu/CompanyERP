@model IEnumerable<BranchIndexViewModel>
@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Branches</h1>
    <a asp-action="Create" class="btn btn-primary">New Branch</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Branch</th>
                    <th>Company</th>
                    <th>Type</th>
                    <th>City</th>
                    <th class="text-center">Head Office</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">In Use</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No branch found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var branch = item.Branch;
                        <tr>
                            <td><span class="badge bg-light text-dark">@branch.Code</span></td>
                            <td>
                                @branch.Name
                                @if (branch.ShortName != null)
                                {
                                    <small class="text-muted d-block">@branch.ShortName</small>
                                }
                            </td>
                            <td>@branch.Company?.Name</td>
                            <td>@branch.BranchType?.Name</td>
                            <td>@branch.City</td>
                            <td class="text-center">
                                @if (branch.IsHeadOffice)
                                {
                                    <span class="badge bg-primary">HQ</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (branch.IsActive)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.EmployeeCount > 0 || item.WarehouseCount > 0)
                                {
                                    <span class="text-muted">@item.EmployeeCount emp, @item.WarehouseCount wh</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Settings" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-info" title="Settings">Settings</a>
                                <a asp-action="Details" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>