@model CashAccount
@{
    ViewData["Title"] = "Delete Cash Account";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Cash Account</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <p class="text-danger fw-semibold">Are you sure you want to delete this cash account?</p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Account Code</dt>
            <dd class="col-sm-9">@Model.AccountCode</dd>
            <dt class="col-sm-3">Account Name</dt>
            <dd class="col-sm-9">@Model.AccountName</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Opening Balance</dt>
            <dd class="col-sm-9">@Model.OpeningBalance.ToString("N2")</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>