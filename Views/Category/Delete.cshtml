@model Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Category</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning">
            Are you sure you want to delete this category?
        </div>
        <dl class="row mb-3">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.Name</dd>
            <dt class="col-sm-3">Category Type</dt>
            <dd class="col-sm-9">@(Model.CategoryType?.Name ?? "-")</dd>
            <dt class="col-sm-3">Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>
            <dt class="col-sm-3">Category Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>