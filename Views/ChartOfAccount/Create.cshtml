@model ChartOfAccount
@{
    ViewData["Title"] = "Add Account";
    var selectedParent = (ViewBag.Parents as IEnumerable<ChartOfAccountParentOption>)?
        .FirstOrDefault(p => p.Id == Model.ParentId);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">New Account</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header py-2">
                <i class="bi bi-diagram-3 me-1"></i><strong class="small">Step 1 — Decide where this account belongs</strong>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="coaForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ParentId" class="form-label"></label>
                            <select asp-for="ParentId" class="form-select">
                                <option value="">— No parent: this becomes a top level Class —</option>
                                @if (ViewBag.Parents is IEnumerable<ChartOfAccountParentOption> parentOptions)
                                {
                                    foreach (var p in parentOptions)
                                    {
                                        var selected = Model.ParentId == p.Id ? " selected" : null;
                                        <option value="@p.Id"
                                                data-type="@p.AccountType"
                                                data-balance="@p.NormalBalance"
                                                selected="@selected">@p.Label</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ParentId" class="text-danger"></span>
                            <div class="form-text">
                                Parents with children cannot be edited or deleted later, so pick the right level.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">It will sit under</label>
                            <div class="coa-path-preview" id="pathPreview">
                                @if (selectedParent is not null)
                                {
                                    <i class="bi bi-signpost-split me-1"></i>@selectedParent.Label
                                }
                                else
                                {
                                    <span class="text-muted">Nothing yet — a new Class</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="mb-2"><i class="bi bi-pencil-square me-1"></i><strong class="small">Step 2 — Name it</strong></div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="AccountCode" class="form-label"></label>
                            <input asp-for="AccountCode" class="form-control" placeholder="e.g. 1010" />
                            <span asp-validation-for="AccountCode" class="text-danger"></span>
                            <div class="form-text">Unique per company.</div>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="AccountName" class="form-label"></label>
                            <input asp-for="AccountName" class="form-control" placeholder="e.g. Cash" />
                            <span asp-validation-for="AccountName" class="text-danger"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="mb-2">
                        <i class="bi bi-sliders me-1"></i><strong class="small">Step 3 — Accounting behaviour</strong>
                        <span class="badge text-bg-light border ms-2" id="lockBadge" style="display: @(selectedParent is not null ? "" : "none");">
                            <i class="bi bi-lock-fill me-1"></i>Set from parent
                        </span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="AccountType" class="form-label"></label>
                            <select asp-for="AccountType" asp-items="Html.GetEnumSelectList<AccountType>()"
                                    class="form-select"></select>
                            <span asp-validation-for="AccountType" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NormalBalance" class="form-label"></label>
                            <select asp-for="NormalBalance" asp-items="Html.GetEnumSelectList<AccountNormalBalance>()"
                                    class="form-select"></select>
                            <span asp-validation-for="NormalBalance" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpeningBalance" class="form-label"></label>
                            <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="OpeningBalance" class="text-danger"></span>
                            <div class="form-text">Only leaves may carry an opening balance.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <input asp-for="Description" class="form-control" placeholder="Optional note shown under the account in the tree" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save account</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header py-2"><strong class="small">How this fits the four layers</strong></div>
            <div class="card-body">
                <ul class="coa-checklist list-unstyled mb-0">
                    <li><span class="coa-level-badge coa-level-1">1</span><div><strong>Class</strong><span class="coa-hint d-block">Assets, Liabilities, Equity, Revenue, Expenses. No parent selected.</span></div></li>
                    <li><span class="coa-level-badge coa-level-2">2</span><div><strong>Group</strong><span class="coa-hint d-block">Pick a Class as parent, e.g. Cash &amp; Bank.</span></div></li>
                    <li><span class="coa-level-badge coa-level-3">3</span><div><strong>Sub-Group</strong><span class="coa-hint d-block">Pick a Group, e.g. Cash Accounts.</span></div></li>
                    <li><span class="coa-level-badge coa-level-4">4</span><div><strong>Leaf</strong><span class="coa-hint d-block">Pick a Sub-Group. This is the only layer a journal entry can post to.</span></div></li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // asp-for renders these ids, so they match the model property names.
            const parentSelect = document.getElementById('ParentId');
            const typeSelect = document.getElementById('AccountType');
            const balanceSelect = document.getElementById('NormalBalance');
            const lockBadge = document.getElementById('lockBadge');
            const preview = document.getElementById('pathPreview');
            if (!parentSelect || !typeSelect || !balanceSelect || !preview) return;

            function sync() {
                const opt = parentSelect.options[parentSelect.selectedIndex];
                const hasParent = !!(opt && opt.value);
                const label = hasParent ? opt.text : null;

                preview.innerHTML = label
                    ? '<i class="bi bi-signpost-split me-1"></i>' + label
                    : '<span class="text-muted">Nothing yet — a new Class</span>';

                // Mirror the parent's class and balance. The service rejects any mismatch
                // (ChartOfAccountService.ValidateParentAsync), so keeping them in sync here
                // is what stops the user from ever seeing that error.
                if (hasParent) {
                    typeSelect.value = opt.dataset.type;
                    balanceSelect.value = opt.dataset.balance;
                }

                // The selects stay enabled so their values still post; we only grey them out.
                [typeSelect, balanceSelect].forEach(el => el.classList.toggle('coa-locked', hasParent));
                if (lockBadge) {
                    lockBadge.style.display = hasParent ? '' : 'none';
                }
            }

            parentSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}
