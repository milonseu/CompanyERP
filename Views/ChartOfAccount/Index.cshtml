@model List<(CompanyERP.Entities.Accounting.ChartOfAccount Account, int Depth)>
@{
    ViewData["Title"] = "Chart of Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Chart of Accounts</h1>
    <a asp-action="Create" class="btn btn-primary">Add Account</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Normal Balance</th>
                        <th>Opening</th>
                        <th>Postable</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var n = item.Account;
                        var indent = item.Depth * 20;
                        <tr class="@(n.IsLeaf ? "" : "table-light")">
                            <td class="text-nowrap">@n.AccountCode</td>
                            <td style="padding-left: @(10 + indent)px;">
                                @if (item.Depth > 0)
                                {
                                    <span class="text-muted me-1">@(n.IsLeaf ? "└─" : "├─")</span>
                                }
                                <span class="@(n.IsLeaf ? "" : "fw-bold")">@n.AccountName</span>
                            </td>
                            <td>@n.AccountType</td>
                            <td>@n.NormalBalance</td>
                            <td class="text-end">@n.OpeningBalance.ToString("N2")</td>
                            <td>@(n.IsPostable ? "Yes" : "No")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@n.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>