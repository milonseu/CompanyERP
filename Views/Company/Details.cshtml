@model CompanyERP.Entities.Company.CompanyProfile
@{
    ViewData["Title"] = "Company Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Company Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>

            <dt class="col-sm-3">Company Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Legal Name</dt>
            <dd class="col-sm-9">@Model.LegalName</dd>

            <dt class="col-sm-3">Registration No</dt>
            <dd class="col-sm-9">@(Model.RegistrationNo ?? "-")</dd>

            <dt class="col-sm-3">Tax ID / BIN</dt>
            <dd class="col-sm-9">@(Model.TaxId ?? "-")</dd>

            <dt class="col-sm-3">VAT Registration No</dt>
            <dd class="col-sm-9">@(Model.VatRegistrationNo ?? "-")</dd>

            <dt class="col-sm-3">Trade License No</dt>
            <dd class="col-sm-9">@(Model.TradeLicenseNo ?? "-")</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "-")</dd>

            <dt class="col-sm-3">Website</dt>
            <dd class="col-sm-9">@(Model.Website ?? "-")</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">
                @Model.Address
                @if (!string.IsNullOrWhiteSpace(Model.City))
                {
                    <text>, </text>@Model.City
                }
                @if (!string.IsNullOrWhiteSpace(Model.State))
                {
                    <text>, </text>@Model.State
                }
                @if (!string.IsNullOrWhiteSpace(Model.PostalCode))
                {
                    <text> - </text>@Model.PostalCode
                }
                @if (!string.IsNullOrWhiteSpace(Model.Country))
                {
                    <text>, </text>@Model.Country
                }
            </dd>

            <dt class="col-sm-3">Currency</dt>
            <dd class="col-sm-9">@Model.CurrencyCode</dd>

            <dt class="col-sm-3">Incorporated On</dt>
            <dd class="col-sm-9">@(Model.IncorporationDate?.ToString("dd-MM-yyyy") ?? "-")</dd>

            <dt class="col-sm-3">Fiscal Year Start Month</dt>
            <dd class="col-sm-9">@(Model.FiscalYearStartMonth.HasValue ? new DateTime(2020, Model.FiscalYearStartMonth.Value, 1).ToString("MMMM") : "-")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>