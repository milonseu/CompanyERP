@model CompanyERP.Entities.Employee.Department
@{
    ViewData["Title"] = "Delete Department";
    var hasEmployees = ViewBag.HasEmployees as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Department</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <div class="alert alert-danger">
            Are you sure you want to delete <strong>@Model.Name</strong>? This action cannot be undone.
        </div>

        @if (hasEmployees)
        {
            <div class="alert alert-warning">
                This department still has employees assigned. Please move or remove them before deleting.
            </div>
        }

        <dl class="row mb-0">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@(Model.Company?.Name ?? "-")</dd>

            <dt class="col-sm-3">Department Code</dt>
            <dd class="col-sm-9">@Model.Code</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>