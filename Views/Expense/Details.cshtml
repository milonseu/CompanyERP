@model ExpenseEntry
@{
    ViewData["Title"] = "Expense Entry Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Expense Entry Details</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Expense No</dt>
            <dd class="col-sm-9">@Model.ExpenseNo</dd>
            <dt class="col-sm-3">Expense Date</dt>
            <dd class="col-sm-9">@Model.ExpenseDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.ExpenseType?.ExpenseCategory?.Name</dd>
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.ExpenseType?.Name</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Supplier</dt>
            <dd class="col-sm-9">@(Model.Supplier?.Name ?? "N/A")</dd>
            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>
            <dt class="col-sm-3">Amount Paid</dt>
            <dd class="col-sm-9">@Model.AmountPaid.ToString("N2")</dd>
            <dt class="col-sm-3">Payment Type</dt>
            <dd class="col-sm-9">@Model.PaymentType</dd>
            <dt class="col-sm-3">Payment Reference</dt>
            <dd class="col-sm-9">@(Model.PaymentReference ?? "N/A")</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "N/A")</dd>
            <dt class="col-sm-3">Created At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
        </dl>
        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>