@model ExpenseEntry
@{
    ViewData["Title"] = "Edit Expense Entry";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Edit Expense Entry</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select" disabled>
                        <option value="">-- Select Company --</option>
                    </select>
                    <input type="hidden" asp-for="CompanyId" />
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpenseNo" class="form-label"></label>
                    <input asp-for="ExpenseNo" class="form-control" readonly />
                    <span asp-validation-for="ExpenseNo" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BranchId" class="form-label"></label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select Branch --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Expense Category</label>
                    <select id="CategorySelect" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpenseTypeId" class="form-label"></label>
                    <select asp-for="ExpenseTypeId" asp-items="ViewBag.Types" class="form-select">
                        <option value="">-- Select Type --</option>
                    </select>
                    <span asp-validation-for="ExpenseTypeId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpenseDate" class="form-label"></label>
                    <input asp-for="ExpenseDate" type="date" class="form-control" />
                    <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentType" class="form-label"></label>
                    <select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<ExpensePaymentType>()" class="form-select"></select>
                    <span asp-validation-for="PaymentType" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AmountPaid" class="form-label"></label>
                    <input asp-for="AmountPaid" class="form-control" />
                    <span asp-validation-for="AmountPaid" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SupplierId" class="form-label"></label>
                    <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PaymentReference" class="form-label"></label>
                    <input asp-for="PaymentReference" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const expenseTypes = @Html.Raw(ViewBag.TypesJson);

        function filterTypes() {
            const categoryId = Number(document.getElementById('CategorySelect').value);
            const typeSelect = document.getElementById('ExpenseTypeId');
            const selected = Number(typeSelect.value);
            typeSelect.innerHTML = '<option value="">-- Select Type --</option>';
            expenseTypes.filter(t => !categoryId || t.ExpenseCategoryId === categoryId).forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.Id;
                opt.text = t.Name;
                if (t.Id === selected) opt.selected = true;
                typeSelect.appendChild(opt);
            });
        }

        document.getElementById('CategorySelect').addEventListener('change', filterTypes);
    </script>
}