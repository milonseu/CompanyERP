@model ExpenseRegisterViewModel
@{
    ViewData["Title"] = "Expense Register";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Expense Register</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Expense Reports</a>
</div>

<form method="get" asp-action="Register" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Supplier</label>
            <select name="supplierId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var s in ViewBag.Suppliers)
                {
                    <option value="@s.Value" selected="@(s.Value == Model.SupplierId.ToString() ? "selected" : null)">@s.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Date</th><th>No</th><th>Type</th><th>Supplier</th><th>Branch</th><th>Description</th>
                    <th class="text-end">Amount</th><th class="text-end">Paid</th><th class="text-end">Outstanding</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("dd-MMM-yyyy")</td><td>@r.ExpenseNo</td><td>@r.Type</td>
                        <td>@r.Supplier</td><td>@r.Branch</td><td>@r.Description</td>
                        <td class="text-end">@r.Amount.ToString("N2")</td><td class="text-end">@r.Paid.ToString("N2")</td>
                        <td class="text-end">@r.Outstanding.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted">No expenses</td></tr>
                }
                <tr class="fw-bold">
                    <td colspan="6" class="text-end">Total</td>
                    <td class="text-end">@Model.TotalAmount.ToString("N2")</td>
                    <td class="text-end">@Model.TotalPaid.ToString("N2")</td>
                    <td class="text-end">@Model.TotalOutstanding.ToString("N2")</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>