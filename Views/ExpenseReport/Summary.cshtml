@model ExpenseSummaryViewModel
@{
    ViewData["Title"] = "Expense by Category / Type";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Expense by Category / Type</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Expense Reports</a>
</div>

<form method="get" asp-action="Summary" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Expense Type</label>
            <select name="expenseTypeId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var t in ViewBag.ExpenseTypes)
                {
                    <option value="@t.Value" selected="@(t.Value == Model.ExpenseTypeId.ToString() ? "selected" : null)">@t.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Type</th><th class="text-end">Count</th><th class="text-end">Amount</th>
                <th class="text-end">Paid</th><th class="text-end">Outstanding</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Type</td><td class="text-end">@r.Count</td><td class="text-end">@r.Amount.ToString("N2")</td>
                    <td class="text-end">@r.Paid.ToString("N2")</td><td class="text-end">@r.Outstanding.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">No expenses</td></tr>
            }
            <tr class="fw-bold">
                <td>Total</td><td class="text-end">@Model.Rows.Sum(r => r.Count)</td>
                <td class="text-end">@Model.TotalAmount.ToString("N2")</td>
                <td class="text-end">@Model.TotalPaid.ToString("N2")</td>
                <td class="text-end">@Model.TotalOutstanding.ToString("N2")</td>
            </tr>
        </tbody>
    </table>
</div>