@model ExpenseTrendViewModel
@{
    ViewData["Title"] = "Monthly Expense Trend";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Monthly Expense Trend</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Expense Reports</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-end">
        <span class="fw-bold">Total: @Model.TotalAmount.ToString("N2")</span>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Month</th><th class="text-end">Count</th><th class="text-end">Amount</th>
                <th class="text-end">Paid</th><th class="text-end">Outstanding</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Month</td><td class="text-end">@r.Count</td><td class="text-end">@r.Amount.ToString("N2")</td>
                    <td class="text-end">@r.Paid.ToString("N2")</td><td class="text-end">@r.Outstanding.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">No expenses</td></tr>
            }
        </tbody>
    </table>
</div>