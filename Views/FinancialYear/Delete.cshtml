@model CompanyERP.Entities.Company.FinancialYear
@{
    ViewData["Title"] = "Delete Financial Year";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Financial Year</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <div class="alert alert-danger">
            Are you sure you want to delete <strong>@Model.Name</strong>? This action cannot be undone.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Year Code</dt>
            <dd class="col-sm-9">@Model.YearCode</dd>

            <dt class="col-sm-3">Financial Year</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsClosed ? "Closed" : "Open")</dd>
        </dl>

        @if (Model.AccountingPeriods.Count > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                This financial year has <strong>@Model.AccountingPeriods.Count</strong> accounting period(s). They must be deleted first.
            </div>
        }

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger" @(Model.AccountingPeriods.Count > 0 ? "disabled" : "")>Delete</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>