@model CompanyERP.Entities.Company.FinancialYear
@{
    ViewData["Title"] = "Financial Year Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Year Code</dt>
            <dd class="col-sm-9">@Model.YearCode</dd>

            <dt class="col-sm-3">Financial Year</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Start Date</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-3">End Date</dt>
            <dd class="col-sm-9">@Model.EndDate.ToString("dd-MM-yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsClosed)
                {
                    <span class="badge bg-secondary">Closed</span>
                }
                else
                {
                    <span class="badge bg-success">Open</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <h2 class="h5">Accounting Periods (@Model.AccountingPeriods.Count)</h2>
    @if (!Model.AccountingPeriods.Any())
    {
        <p class="text-muted">No accounting period has been created for this financial year.</p>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Period Code</th>
                            <th>Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var period in Model.AccountingPeriods)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark">@period.PeriodCode</span></td>
                                <td>@period.Name</td>
                                <td>@period.StartDate.ToString("dd-MM-yyyy")</td>
                                <td>@period.EndDate.ToString("dd-MM-yyyy")</td>
                                <td class="text-center">
                                    @if (period.Status == CompanyERP.Entities.Company.AccountingPeriodStatus.Open)
                                    {
                                        <span class="badge bg-success">Open</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>