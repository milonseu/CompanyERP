@model IEnumerable<CompanyERP.Entities.Company.FinancialYear>
@{
    ViewData["Title"] = "Financial Years";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Financial Years</h1>
    <a asp-action="Create" class="btn btn-primary">New Financial Year</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Year Code</th>
                    <th>Financial Year</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th class="text-center">Periods</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No financial year found. Click "New Financial Year" to create one.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark">@item.YearCode</span></td>
                            <td>@item.Name</td>
                            <td>@item.StartDate.ToString("dd-MM-yyyy")</td>
                            <td>@item.EndDate.ToString("dd-MM-yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Periods" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">@item.AccountingPeriods.Count Period(s)</a>
                            </td>
                            <td class="text-center">
                                @if (item.IsClosed)
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Open</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>