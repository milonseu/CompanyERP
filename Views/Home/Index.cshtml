@model CompanyERP.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var monthlyLabels = Model.Monthly.Select(m => m.Label).ToArray();
    var salesSeries = Model.Monthly.Select(m => (double)m.Sales).ToArray();
    var purchaseSeries = Model.Monthly.Select(m => (double)m.Purchases).ToArray();
    var categoryLabels = Model.CategorySales.Select(c => c.Label).ToArray();
    var categoryValues = Model.CategorySales.Select(c => (double)c.Amount).ToArray();
}

@functions {
    static string M(decimal v) => v.ToString("N2");
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0 fw-semibold text-dark">Dashboard</h1>
        <small class="text-muted">@Model.CompanyName &middot; Financial overview</small>
    </div>
    <div class="d-flex gap-2">
        <span class="badge rounded-pill text-bg-light border px-3 py-2 text-secondary">
            <i class="bi bi-people me-1"></i>@Model.CustomerCount Customers
        </span>
        <span class="badge rounded-pill text-bg-light border px-3 py-2 text-secondary">
            <i class="bi bi-truck me-1"></i>@Model.SupplierCount Suppliers
        </span>
        <span class="badge rounded-pill text-bg-light border px-3 py-2 text-secondary">
            <i class="bi bi-person-badge me-1"></i>@Model.EmployeeCount Staff
        </span>
        <span class="badge rounded-pill text-bg-light border px-3 py-2 text-secondary">
            <i class="bi bi-box-seam me-1"></i>@Model.ProductCount Products
        </span>
    </div>
</div>

<!-- KPI cards -->
<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary"><i class="bi bi-cart3 fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Total Sales</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.TotalSales)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info"><i class="bi bi-bag-check fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Total Purchases</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.TotalPurchases)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning"><i class="bi bi-cash-coin fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Receivables</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.ReceivablesOutstanding)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-danger bg-opacity-10 text-danger"><i class="bi bi-bank fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Payables</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.PayablesOutstanding)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success"><i class="bi bi-box-seam fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Stock Value</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.StockValue)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-teal bg-opacity-10 text-teal"><i class="bi bi-wallet2 fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Cash &amp; Bank</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.CashBankBalance)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-building fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Assets (Book)</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.AssetBookValue)</div>
                    <div class="small text-muted">@Model.AssetCount assets</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-purple bg-opacity-10 text-purple"><i class="bi bi-receipt fs-4"></i></div>
                <div class="flex-grow-1">
                    <div class="text-muted small text-uppercase">Expenses</div>
                    <div class="h5 mb-0 fw-semibold">৳ @M(Model.TotalExpenses)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <div class="fw-semibold text-dark">Sales vs Purchases</div>
                <div class="text-muted small">Last 8 months</div>
            </div>
            <div class="card-body">
                <canvas id="salesChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0">
                <div class="fw-semibold text-dark">Sales by Category</div>
                <div class="text-muted small">All-time product sales</div>
            </div>
            <div class="card-body d-flex flex-column justify-content-center">
                <canvas id="categoryChart" height="185"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Alerts -->
<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle text-warning"></i>
                <div class="fw-semibold text-dark">Low Stock</div>
            </div>
            <div class="card-body">
                @if (Model.LowStock.Count == 0)
                {
                    <div class="text-muted small py-2">No low-stock items.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.LowStock)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                                <div class="me-2">
                                    <div class="small fw-semibold text-dark">@item.Product</div>
                                    <div class="small text-muted">@item.Code</div>
                                </div>
                                <span class="small">On hand <strong class="text-danger">@M(item.OnHand)</strong> / min @M(item.Minimum)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center gap-2">
                <i class="bi bi-hourglass-split text-warning"></i>
                <div class="fw-semibold text-dark">Top Receivables</div>
            </div>
            <div class="card-body">
                @if (Model.TopReceivables.Count == 0)
                {
                    <div class="text-muted small py-2">No outstanding receivables.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var r in Model.TopReceivables)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-dark">@r.Customer</span>
                                <span class="fw-semibold">৳ @M(r.Outstanding)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center gap-2">
                <i class="bi bi-hourglass-bottom text-warning"></i>
                <div class="fw-semibold text-dark">Top Payables</div>
            </div>
            <div class="card-body">
                @if (Model.TopPayables.Count == 0)
                {
                    <div class="text-muted small py-2">No outstanding payables.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in Model.TopPayables)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-dark">@p.Supplier</span>
                                <span class="fw-semibold">৳ @M(p.Outstanding)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent activity -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center justify-content-between">
                <div class="fw-semibold text-dark">Recent Invoices</div>
                <a class="small text-decoration-none" asp-controller="SalesInvoices" asp-action="Index">View all</a>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-3">Invoice</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th class="text-end pe-3">Amount</th>
                            <th class="text-end pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSales)
                        {
                            <tr>
                                <td class="ps-3">@s.InvoiceNo</td>
                                <td>@s.Party</td>
                                <td>@s.Date.ToString("dd-MMM-yy")</td>
                                <td class="text-end pe-3 fw-semibold">৳ @M(s.Amount)</td>
                                <td class="text-end pe-3">
                                    @if (s.Status == "Paid")
                                    {
                                        <span class="badge text-bg-success">Paid</span>
                                    }
                                    else if (s.Status == "Partial")
                                    {
                                        <span class="badge text-bg-warning">Partial</span>
                                    }
                                    else if (s.Status == "Due")
                                    {
                                        <span class="badge text-bg-danger">Due</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Cancelled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 pb-0 d-flex align-items-center justify-content-between">
                <div class="fw-semibold text-dark">Recent Payments</div>
                <a class="small text-decoration-none" asp-controller="Payments" asp-action="Index">View all</a>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-3">Payment</th>
                            <th>Party</th>
                            <th>Date</th>
                            <th class="text-end pe-3">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td class="ps-3">@p.PaymentNo</td>
                                <td>
                                    <div>@p.Party</div>
                                    <div class="small text-muted">@p.Category</div>
                                </td>
                                <td>@p.Date.ToString("dd-MMM-yy")</td>
                                <td class="text-end pe-3 fw-semibold">৳ @M(p.Amount)</td>
                            </tr>
                        }
                        @if (Model.RecentPayments.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted small px-3">No payments found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const palette = ['#0d6efd', '#20c997', '#ffc107', '#dc3545', '#6610f2', '#6f42c1'];
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categoryLabels.Length > 0 ? categoryLabels : new[] { "No data" }));
            const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categoryValues.Length > 0 ? categoryValues : new double[] { 0 }));

            new Chart(document.getElementById('salesChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyLabels)),
                    datasets: [
                        {
                            label: 'Sales',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(salesSeries)),
                            backgroundColor: 'rgba(13, 110, 253, 0.75)',
                            borderColor: '#0d6efd',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Purchases',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(purchaseSeries)),
                            backgroundColor: 'rgba(32, 201, 151, 0.75)',
                            borderColor: '#20c997',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'top', labels: { boxWidth: 12 } } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: v => '৳' + Number(v).toLocaleString() },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });

            new Chart(document.getElementById('categoryChart'), {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: palette.slice(0, labels.length),
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } }
                    }
                }
            });
        })();
    </script>
}