@model AssetCustodyViewModel
@{
    ViewData["Title"] = "Asset Custody List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Asset Custody List</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">HR Reports</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-end">
        <span class="fw-bold">Total Assignments: @Model.TotalAssignments</span>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Emp Code</th><th>Employee</th><th>Department</th>
                <th>Asset Code</th><th>Asset Name</th><th>Serial No</th><th>Assigned On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.EmployeeCode</td><td>@r.Employee</td><td>@r.Department</td>
                    <td>@r.AssetCode</td><td>@r.AssetName</td><td>@r.SerialNumber</td><td>@r.AssignedOn.ToString("dd-MMM-yyyy")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">No assets assigned</td></tr>
            }
        </tbody>
    </table>
</div>