@{
    ViewData["Title"] = "HR Reports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">HR Reports</h1>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Home</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Salary &amp; Payroll</strong></div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><a asp-action="Salary">Salary Summary</a></li>
                <li class="list-group-item"><a asp-action="SalaryRegister">Salary / Payroll Register</a></li>
            </ul>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Employee</strong></div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><a asp-action="EmployeeList">Department-wise Employee List</a></li>
                <li class="list-group-item"><a asp-action="AssetCustody">Asset Custody List</a></li>
            </ul>
        </div>
    </div>
</div>