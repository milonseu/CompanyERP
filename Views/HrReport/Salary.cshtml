@model SalarySummaryViewModel
@{
    ViewData["Title"] = "Salary Summary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Salary Summary</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">HR Reports</a>
</div>

<form method="get" asp-action="Salary" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Department</label>
            <select name="departmentId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var d in ViewBag.Departments)
                {
                    <option value="@d.Value" selected="@(d.Value == Model.DepartmentId.ToString() ? "selected" : null)">@d.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Employees</div><div class="fs-5 fw-bold">@Model.Rows.Count</div></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Total Paid</div><div class="fs-5 fw-bold">@Model.TotalPaid.ToString("N2")</div></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Total Pending</div><div class="fs-5 fw-bold">@Model.TotalPending.ToString("N2")</div></div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Emp Code</th><th>Employee</th><th>Department</th>
                <th class="text-end">Payments</th><th class="text-end">Paid</th><th class="text-end">Pending</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.EmployeeCode</td><td>@r.Name</td><td>@r.Department</td>
                    <td class="text-end">@r.Payments</td><td class="text-end">@r.Paid.ToString("N2")</td><td class="text-end">@r.Pending.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">No data</td></tr>
            }
        </tbody>
    </table>
</div>