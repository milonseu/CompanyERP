@model IEnumerable<CompanyERP.Entities.Inventory.StockTransaction>
@{
    ViewData["Title"] = "Stock Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Transactions</h1>
    <a asp-action="Balance" class="btn btn-outline-secondary">Stock Balance</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="productId" asp-items="ViewBag.Products" class="form-select">
            <option value="">-- All Products --</option>
        </select>
    </div>
    <div class="col-md-4">
        <select name="warehouseId" asp-items="ViewBag.Warehouses" class="form-select">
            <option value="">-- All Warehouses --</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="branchId" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- All Branches --</option>
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Transactions" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Branch</th>
                    <th>Warehouse</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit Cost</th>
                    <th>Note</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">No transaction found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Product?.Name</td>
                            <td>@(item.Warehouse?.Branch?.Name ?? "-")</td>
                            <td>
                                @item.Warehouse?.Name
                                @if (item.ToWarehouse != null)
                                {
                                    <span class="text-muted">-> @item.ToWarehouse.Name</span>
                                }
                            </td>
                            <td>@item.Type.GetDisplayName()</td>
                            <td><span class="badge bg-light text-dark">@item.ReferenceNo</span></td>
                            <td class="text-end @(item.Quantity < 0 ? "text-danger" : "text-success")">
                                @(item.Quantity < 0 ? item.Quantity.ToString("N3") : "+" + item.Quantity.ToString("N3"))
                            </td>
                            <td class="text-end">@item.UnitCost.ToString("N2")</td>
                            <td>@(item.Note ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>