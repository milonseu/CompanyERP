@model IEnumerable<CompanyERP.Entities.Inventory.StockTransfer>
@{
    ViewData["Title"] = "Stock Transfers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Transfers</h1>
    <a asp-action="Transfer" class="btn btn-primary">New Transfer</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>From</th>
                    <th>To</th>
                    <th class="text-end">Quantity</th>
                    <th>Note</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No transfer found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TransferDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Product?.Name</td>
                            <td>@item.FromWarehouse?.Name</td>
                            <td>@item.ToWarehouse?.Name</td>
                            <td class="text-end">@item.Quantity.ToString("N3")</td>
                            <td>@(item.Note ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Transactions" asp-route-productId="@item.ProductId" class="btn btn-sm btn-outline-primary">History</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>