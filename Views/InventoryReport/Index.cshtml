@{
    ViewData["Title"] = "Inventory Reports";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h3 mb-3">Inventory Reports</h1>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Stock Report</h2>
                        <p class="text-muted small">Stock on hand, average cost, valuation and low stock per warehouse.</p>
                        <a asp-action="Stock" class="btn btn-sm btn-outline-primary">Open</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Stock Movement</h2>
                        <p class="text-muted small">In/out stock transactions with quantities and values.</p>
                        <a asp-action="Movement" class="btn btn-sm btn-outline-primary">Open</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>