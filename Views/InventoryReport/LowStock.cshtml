@model LowStockViewModel
@{
    ViewData["Title"] = "Low Stock";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Low Stock</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Inventory Reports</a>
</div>

<form method="get" asp-action="LowStock" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.Value" selected="@(c.Value == Model.CategoryId.ToString() ? "selected" : null)">@c.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-end">
        <span class="fw-bold @(Model.Count > 0 ? "text-danger" : "")">Low Stock Items: @Model.Count</span>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Code</th><th>Product</th><th>Category</th><th>Warehouse</th>
                <th class="text-end">On Hand</th><th class="text-end">Min Level</th><th class="text-end">Shortfall</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Code</td><td>@r.Product</td><td>@r.Category</td><td>@r.Warehouse</td>
                    <td class="text-end">@r.OnHand.ToString("N2")</td><td class="text-end">@r.MinimumStockLevel.ToString("N2")</td>
                    <td class="text-end text-danger">@r.Shortfall.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">All stocked items are at or above minimum level</td></tr>
            }
        </tbody>
    </table>
</div>