@model StockMovementViewModel
@{
    ViewData["Title"] = "Stock Movement";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Movement</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Inventory Reports</a>
</div>

<form method="get" asp-action="Movement" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-sm mb-0 align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Code</th>
                    <th>Product</th>
                    <th>Warehouse</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("dd MMM yyyy")</td>
                        <td>@r.Code</td>
                        <td>@r.Product</td>
                        <td>@r.Warehouse</td>
                        <td>@r.Type</td>
                        <td>@r.Reference</td>
                        <td class="text-end">@r.Quantity.ToString("N2")</td>
                        <td class="text-end">@r.UnitCost.ToString("N2")</td>
                        <td class="text-end">@r.Value.ToString("N2")</td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted">No movement in period</td></tr>
                }
            </tbody>
        </table>
        <div class="d-flex justify-content-end gap-4 mt-2 fw-bold">
            <span>Stock In: @Model.TotalIn.ToString("N2")</span>
            <span>Stock Out: @Model.TotalOut.ToString("N2")</span>
        </div>
    </div>
</div>