@model StockReportViewModel
@{
    ViewData["Title"] = "Stock Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Report</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Inventory Reports</a>
</div>

<form method="get" asp-action="Stock" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Category</label>
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.Value" selected="@(c.Value == Model.CategoryId.ToString() ? "selected" : null)">@c.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Warehouse</label>
            <select name="warehouseId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var w in ViewBag.Warehouses)
                {
                    <option value="@w.Value" selected="@(w.Value == Model.WarehouseId.ToString() ? "selected" : null)">@w.Text</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-sm mb-0 align-middle">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Warehouse</th>
                    <th class="text-end">Qty On Hand</th>
                    <th class="text-end">Avg Cost</th>
                    <th class="text-end">Value</th>
                    <th class="text-end">Min Stock</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Code</td>
                        <td>@r.Product</td>
                        <td>@r.Category</td>
                        <td>@r.Warehouse</td>
                        <td class="text-end">@r.Quantity.ToString("N2")</td>
                        <td class="text-end">@r.AverageCost.ToString("N2")</td>
                        <td class="text-end">@r.Value.ToString("N2")</td>
                        <td class="text-end">@r.MinimumStockLevel.ToString("N2")</td>
                        <td><span class="badge @(r.LowStock == "Low" ? "bg-danger" : "bg-success")">@r.LowStock</span></td>
                    </tr>
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted">No stock balances</td></tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td colspan="4">Total</td>
                    <td class="text-end">@Model.TotalQuantity.ToString("N2")</td>
                    <td></td>
                    <td class="text-end">@Model.TotalValue.ToString("N2")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>