@model WarehouseStockViewModel
@{
    ViewData["Title"] = "Warehouse-wise Stock Summary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Warehouse-wise Stock Summary</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Inventory Reports</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Total Quantity</div><div class="fs-5 fw-bold">@Model.TotalQuantity.ToString("N2")</div></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Total Value</div><div class="fs-5 fw-bold">@Model.TotalValue.ToString("N2")</div></div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Warehouse</th><th class="text-end">Products</th><th class="text-end">Quantity</th><th class="text-end">Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Warehouse</td><td class="text-end">@r.Products</td><td class="text-end">@r.Quantity.ToString("N2")</td>
                    <td class="text-end">@r.Value.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted">No stock</td></tr>
            }
        </tbody>
    </table>
</div>