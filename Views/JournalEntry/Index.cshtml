@model List<JournalEntry>
@{
    ViewData["Title"] = "Journal Entries";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Journal Entries</h1>
    <a asp-action="Create" class="btn btn-primary">New Journal Entry</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label small">Company</label>
        <select name="companyId" asp-items="ViewBag.Companies" class="form-select">
            <option>-- All --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small">Branch</label>
        <select name="branchId" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- All Branches --</option>
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Entry No</th>
                        <th>Date</th>
                        <th>Period</th>
                        <th>Branch</th>
                        <th>Source</th>
                        <th>Description</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@entry.Id">@entry.EntryNo</a></td>
                            <td>@entry.EntryDate.ToString("yyyy-MM-dd")</td>
                            <td>@entry.PeriodKey</td>
                            <td>@(entry.Branch?.Name ?? "-")</td>
                            <td>@entry.SourceModule</td>
                            <td>@entry.Description</td>
                            <td class="text-end">@entry.TotalDebit.ToString("N2")</td>
                            <td class="text-end">@entry.TotalCredit.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>