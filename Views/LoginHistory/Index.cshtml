@model IEnumerable<CompanyERP.Entities.Security.LoginHistory>
@{
    ViewData["Title"] = "Login History";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Login History</h1>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Login Time</th>
                        <th>User</th>
                        <th class="text-center">Result</th>
                        <th>IP</th>
                        <th>Logout Time</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No login recorded.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-nowrap">@item.LoginTime.ToString("g")</td>
                                <td><span class="badge bg-light text-dark">@item.UserName</span></td>
                                <td class="text-center">
                                    @if (item.IsSuccess)
                                    {
                                        <span class="badge bg-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Failed</span>
                                    }
                                </td>
                                <td>@(item.IpAddress ?? "-")</td>
                                <td>@(item.LogoutTime?.ToString("g") ?? "-")</td>
                                <td>@(item.FailReason ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>