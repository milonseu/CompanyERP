@model Payment
@{
    ViewData["Title"] = "New Payment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">New Payment</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" id="paymentForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="CompanyId" class="form-label"></label>
                    <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select">
                        <option value="">-- Select Company --</option>
                    </select>
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BranchId" class="form-label"></label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select Branch --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label"></label>
                    <select asp-for="Category" asp-items="ViewBag.Categories" class="form-select" id="categorySelect"></select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PaymentNo" class="form-label"></label>
                    <input asp-for="PaymentNo" class="form-control" readonly />
                    <span asp-validation-for="PaymentNo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PaymentDate" class="form-label"></label>
                    <input asp-for="PaymentDate" type="date" class="form-control" />
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>
            </div>

            <div id="section-Customer" class="pay-section mt-3" style="display:none;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label"></label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SourceReferenceNo" class="form-label"></label>
                        <input asp-for="SourceReferenceNo" class="form-control" placeholder="Invoice no / opening" />
                    </div>
                </div>
            </div>

            <div id="section-Supplier" class="pay-section mt-3" style="display:none;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="SupplierId" class="form-label"></label>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                            <option value="">-- Select Supplier --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SourceReferenceNo" class="form-label"></label>
                        <input asp-for="SourceReferenceNo" class="form-control" placeholder="Invoice no / opening" />
                    </div>
                </div>
            </div>

            <div id="section-Expense" class="pay-section mt-3" style="display:none;">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="ExpenseEntryId" class="form-label"></label>
                        <select asp-for="ExpenseEntryId" asp-items="ViewBag.ExpenseCandidates" class="form-select">
                            <option value="">-- Select Expense Entry --</option>
                        </select>
                        <span asp-validation-for="ExpenseEntryId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div id="section-Salary" class="pay-section mt-3" style="display:none;">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="SalaryPaymentId" class="form-label"></label>
                        <select asp-for="SalaryPaymentId" asp-items="ViewBag.SalaryCandidates" class="form-select">
                            <option value="">-- Select Salary Payment --</option>
                        </select>
                        <span asp-validation-for="SalaryPaymentId" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div id="section-Asset" class="pay-section mt-3" style="display:none;">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AssetRegisterId" class="form-label"></label>
                        <select asp-for="AssetRegisterId" asp-items="ViewBag.AssetCandidates" class="form-select">
                            <option value="">-- Select Asset --</option>
                        </select>
                        <span asp-validation-for="AssetRegisterId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SourceReferenceNo" class="form-label"></label>
                        <input asp-for="SourceReferenceNo" class="form-control" placeholder="Asset no / agreement no" />
                    </div>
                </div>
            </div>

            <hr class="my-4" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="PaymentMethodId" class="form-label"></label>
                    <select asp-for="PaymentMethodId" asp-items="ViewBag.PaymentMethods" class="form-select">
                        <option value="">-- Select Method --</option>
                    </select>
                    <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="AccountType" class="form-label"></label>
                    <div class="d-flex gap-3 pt-1">
                        <div class="form-check">
                            <input class="form-check-input account-type" type="radio" asp-for="AccountType" value="0" id="atCash" />
                            <label class="form-check-label" for="atCash">Cash</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input account-type" type="radio" asp-for="AccountType" value="1" id="atBank" />
                            <label class="form-check-label" for="atBank">Bank</label>
                        </div>
                    </div>
                    <span asp-validation-for="AccountType" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6" id="cashAccountBox" style="display:none;">
                    <label asp-for="CashAccountId" class="form-label"></label>
                    <select asp-for="CashAccountId" asp-items="ViewBag.CashAccounts" class="form-select">
                        <option value="">-- Select Cash Account --</option>
                    </select>
                    <span asp-validation-for="CashAccountId" class="text-danger"></span>
                </div>
                <div class="col-md-6" id="bankAccountBox" style="display:none;">
                    <label asp-for="BankAccountId" class="form-label"></label>
                    <select asp-for="BankAccountId" asp-items="ViewBag.BankAccounts" class="form-select">
                        <option value="">-- Select Bank Account --</option>
                    </select>
                    <span asp-validation-for="BankAccountId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReferenceNo" class="form-label"></label>
                    <input asp-for="ReferenceNo" class="form-control" placeholder="Bank / cheque reference" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" />
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Payment</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var categorySelect = document.getElementById('categorySelect');
            var sections = document.querySelectorAll('.pay-section');

            function syncSections() {
                var val = categorySelect ? categorySelect.value : '@((int)Model.Category)';
                sections.forEach(function (s) {
                    s.style.display = (s.id === 'section-' + val) ? '' : 'none';
                });
            }

            if (categorySelect) {
                categorySelect.addEventListener('change', syncSections);
            }
            syncSections();

            var cashBox = document.getElementById('cashAccountBox');
            var bankBox = document.getElementById('bankAccountBox');
            var radios = document.querySelectorAll('.account-type');
            function syncAccounts() {
                var val = document.querySelector('.account-type:checked');
                var isBank = val && val.value === '1' ? true : false;
                if (cashBox) cashBox.style.display = isBank ? 'none' : '';
                if (bankBox) bankBox.style.display = isBank ? '' : 'none';
            }
            radios.forEach(function (r) { r.addEventListener('change', syncAccounts); });
            syncAccounts();
        })();
    </script>
}