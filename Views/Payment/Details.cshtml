@model Payment
@{
    ViewData["Title"] = "Payment Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payment #@Model.PaymentNo</h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this payment?');">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Payment No</dt>
            <dd class="col-sm-9">@Model.PaymentNo</dd>
            <dt class="col-sm-3">Payment Date</dt>
            <dd class="col-sm-9">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.Name</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Status == PaymentStatus.Posted)
                {
                    <span class="badge text-bg-success">Posted</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Void</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header fw-semibold">Source</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Source Module</dt>
            <dd class="col-sm-9">@Model.SourceModule</dd>
            <dt class="col-sm-3">Source Reference</dt>
            <dd class="col-sm-9">@Model.SourceReferenceNo</dd>
            @switch (Model.Category)
            {
                case PaymentCategory.Customer:
                    <dt class="col-sm-3">Customer</dt>
                    <dd class="col-sm-9">@Model.Customer?.Name</dd>
                    break;
                case PaymentCategory.Supplier:
                    <dt class="col-sm-3">Supplier</dt>
                    <dd class="col-sm-9">@Model.Supplier?.Name</dd>
                    break;
                case PaymentCategory.Expense:
                    <dt class="col-sm-3">Expense Entry</dt>
                    <dd class="col-sm-9">@Model.ExpenseEntry?.ExpenseNo - @Model.ExpenseEntry?.Description</dd>
                    break;
                case PaymentCategory.Salary:
                    <dt class="col-sm-3">Employee</dt>
                    <dd class="col-sm-9">@Model.SalaryPayment?.Employee?.Name</dd>
                    <dt class="col-sm-3">Salary Month</dt>
                    <dd class="col-sm-9">@(Model.SalaryPayment?.ForMonth.ToString("yyyy-MM"))</dd>
                    break;
                case PaymentCategory.Asset:
                    <dt class="col-sm-3">Asset</dt>
                    <dd class="col-sm-9">@Model.AssetRegister?.AssetNo - @Model.AssetRegister?.Name</dd>
                    break;
            }
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold">Payment Method &amp; Account</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Payment Method</dt>
            <dd class="col-sm-9">@Model.PaymentMethod?.Name</dd>
            <dt class="col-sm-3">Account Type</dt>
            <dd class="col-sm-9">@Model.AccountType</dd>
            <dt class="col-sm-3">Account</dt>
            <dd class="col-sm-9">
                @if (Model.AccountType == PaymentAccountType.Cash)
                {
                    <span>@Model.CashAccount?.AccountName</span>
                }
                else
                {
                    <span>@Model.BankAccount?.AccountName</span>
                }
            </dd>
            <dt class="col-sm-3">Reference No</dt>
            <dd class="col-sm-9">@Model.ReferenceNo</dd>
            <dt class="col-sm-3">Note</dt>
            <dd class="col-sm-9">@Model.Note</dd>
        </dl>
    </div>
</div>