@model PaymentSummaryViewModel
@{
    ViewData["Title"] = "Payment Summary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payment Summary</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Payment Reports</a>
</div>

<form method="get" asp-action="Summary" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Branch</label>
            <select name="branchId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var b in ViewBag.Branches)
                {
                    <option value="@b.Value" selected="@(b.Value == Model.BranchId.ToString() ? "selected" : null)">@b.Text</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header"><strong>By Payment Method</strong></div>
            <table class="table table-sm mb-0 align-middle">
                <thead><tr><th>Method</th><th class="text-end">Count</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    @foreach (var m in Model.Methods)
                    {
                        <tr><td>@m.Name</td><td class="text-end">@m.Count</td><td class="text-end">@m.Amount.ToString("N2")</td></tr>
                    }
                    @if (Model.Methods.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted">No payments</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header"><strong>By Category</strong></div>
            <table class="table table-sm mb-0 align-middle">
                <thead><tr><th>Category</th><th class="text-end">Count</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr><td>@c.Category</td><td class="text-end">@c.Count</td><td class="text-end">@c.Amount.ToString("N2")</td></tr>
                    }
                    @if (Model.Categories.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted">No payments</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header"><strong>By Account</strong></div>
            <table class="table table-sm mb-0 align-middle">
                <thead><tr><th>Account</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        <tr><td>@a.Name</td><td class="text-end">@a.Amount.ToString("N2")</td></tr>
                    }
                    @if (Model.Accounts.Count == 0)
                    {
                        <tr><td colspan="2" class="text-center text-muted">No payments</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body d-flex justify-content-end fw-bold">
        <span>Total Payments: @Model.TotalAmount.ToString("N2")</span>
    </div>
</div>