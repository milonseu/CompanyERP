@model IEnumerable<CompanyERP.Entities.Security.Permission>
@{
    ViewData["Title"] = "Permissions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Permissions</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Permission</a>
</div>

@{
    var missingGroups = ViewBag.MissingCatalog as IEnumerable<IGrouping<string, CompanyERP.Services.Security.SecurityDefs.CatalogItem>>;
}

@if (missingGroups is not null && missingGroups.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-2 d-flex align-items-center gap-2">
            <i class="bi bi-stack"></i><span class="fw-semibold">Permission Catalog</span>
            <span class="badge bg-warning text-dark">@missingGroups.Sum(g => g.Count()) not enabled yet</span>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                These are the permission codes the application checks. Enable the ones you want to
                assign to roles and users.
            </p>
            @foreach (var group in missingGroups)
            {
                <div class="mb-3">
                    <div class="fw-semibold mb-1">@group.Key</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var item in group.OrderBy(i => i.Code))
                        {
                            <form asp-action="AddFromCatalog" method="post" class="m-0" style="display:inline-flex;">
                                <input type="hidden" name="code" value="@item.Code" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-plus-circle"></i> @item.Code
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> All catalog permissions are enabled.</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Permission Code</th>
                    <th>Permission</th>
                    <th>Module</th>
                    <th class="text-center">Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No permission found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark">@item.Code</span>
                                @if (item.IsSystem)
                                {
                                    <i class="bi bi-lock-fill text-secondary" title="System permission"></i>
                                }
                            </td>
                            <td>@item.Name</td>
                            <td><span class="badge bg-info">@(item.Module ?? "-")</span></td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>