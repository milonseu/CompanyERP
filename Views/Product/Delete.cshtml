@model CompanyERP.Entities.Inventory.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Product</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning">Are you sure you want to delete the product <strong>@Model.Name (@Model.Code)</strong>?</div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.Name</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>
            <dt class="col-sm-3">Cost / Sale</dt>
            <dd class="col-sm-9">@Model.CostPrice.ToString("N2") / @Model.SalePrice.ToString("N2")</dd>
        </dl>
        <form asp-action="Delete" method="post" class="mt-3">
            <input asp-for="Id" type="hidden" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>