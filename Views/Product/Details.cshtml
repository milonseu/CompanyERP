@model CompanyERP.Entities.Inventory.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.Name</dd>
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>
            <dt class="col-sm-3">Product Code</dt>
            <dd class="col-sm-9"><span class="badge bg-light text-dark">@Model.Code</span></dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Description ?? "-")</dd>
            <dt class="col-sm-3">Unit</dt>
            <dd class="col-sm-9">@(Model.Unit ?? "-")</dd>
            <dt class="col-sm-3">Cost Price</dt>
            <dd class="col-sm-9">@Model.CostPrice.ToString("N2")</dd>
            <dt class="col-sm-3">Sale Price</dt>
            <dd class="col-sm-9">@Model.SalePrice.ToString("N2")</dd>
            <dt class="col-sm-3">Minimum Stock Level</dt>
            <dd class="col-sm-9">@Model.MinimumStockLevel.ToString("N3")</dd>
            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>
        <div class="mt-4 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        </div>
    </div>
</div>