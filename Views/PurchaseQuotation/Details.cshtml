@model PurchaseQuotation
@{
    ViewData["Title"] = "Purchase Quotation Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchase Quotation Details</h1>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        @if (Model.Status == PurchaseQuotationStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Company</dt>
            <dd class="col-sm-4">@Model.Company?.Name</dd>
            <dt class="col-sm-2">Quotation No</dt>
            <dd class="col-sm-4">@Model.QuotationNo</dd>
            <dt class="col-sm-2">Supplier</dt>
            <dd class="col-sm-4">@Model.Supplier?.Name</dd>
            <dt class="col-sm-2">Reference Request</dt>
            <dd class="col-sm-4">@(Model.PurchaseRequest?.RequestNo ?? "-")</dd>
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-4">@Model.QuotationDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-2">Valid Until</dt>
            <dd class="col-sm-4">@(Model.ValidUntil?.ToString("dd MMM yyyy") ?? "-")</dd>
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-4">@Model.Status</dd>
            <dt class="col-sm-2">Note</dt>
            <dd class="col-sm-10">@(Model.Note ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Lines.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No lines.</td>
                    </tr>
                }
                else
                {
                    var idx = 1;
                    @foreach (var line in Model.Lines)
                    {
                        var total = line.Quantity * line.UnitPrice;
                        <tr>
                            <td>@(idx++)</td>
                            <td>@line.Product?.Name</td>
                            <td class="text-end">@line.Quantity</td>
                            <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                            <td class="text-end">@total.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="table-light">
                        <td colspan="4" class="text-end fw-bold">Grand Total</td>
                        <td class="text-end fw-bold">@Model.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>