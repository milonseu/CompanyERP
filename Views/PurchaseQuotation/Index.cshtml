@model IEnumerable<PurchaseQuotation>
@{
    ViewData["Title"] = "Purchase Quotations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchase Quotations</h1>
    <a asp-action="Create" class="btn btn-primary">New Purchase Quotation</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Quotation No</th>
                    <th>Date</th>
                    <th>Valid Until</th>
                    <th>Supplier</th>
                    <th class="text-center">Lines</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No purchase quotation found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Company?.Name</td>
                            <td>@item.QuotationNo</td>
                            <td>@item.QuotationDate.ToString("dd MMM yyyy")</td>
                            <td>@(item.ValidUntil?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>@item.Supplier?.Name</td>
                            <td class="text-center">@item.Lines.Count</td>
                            <td>
                                @if (item.Status == PurchaseQuotationStatus.Accepted)
                                {
                                    <span class="badge bg-success">Accepted</span>
                                }
                                else if (item.Status == PurchaseQuotationStatus.Cancelled)
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else if (item.Status == PurchaseQuotationStatus.Sent)
                                {
                                    <span class="badge bg-info">Sent</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Draft</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                                @if (item.Status == PurchaseQuotationStatus.Draft)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form asp-action="SendToSupplier" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success">Send</button>
                                    </form>
                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel</button>
                                    </form>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>