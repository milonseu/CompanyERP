@model PurchaseSummaryViewModel
@{
    ViewData["Title"] = "Purchase Register / Summary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchase Register / Summary</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Purchase Reports</a>
</div>

<form method="get" asp-action="Summary" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Invoices</div><div class="fs-5 fw-bold">@Model.TotalInvoices</div></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Quantity</div><div class="fs-5 fw-bold">@Model.TotalQuantity.ToString("N2")</div></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm text-center">
            <div class="card-body"><div class="text-muted small">Purchases</div><div class="fs-5 fw-bold">@Model.TotalPurchases.ToString("N2")</div></div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Supplier</th><th class="text-end">Invoices</th><th class="text-end">Quantity</th><th class="text-end">Purchases</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Supplier</td><td class="text-end">@r.InvoiceCount</td><td class="text-end">@r.Quantity.ToString("N2")</td>
                    <td class="text-end">@r.Purchases.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted">No purchases</td></tr>
            }
        </tbody>
    </table>
</div>