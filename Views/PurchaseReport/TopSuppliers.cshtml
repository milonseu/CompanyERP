@model TopSuppliersViewModel
@{
    ViewData["Title"] = "Top Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Top Suppliers</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Purchase Reports</a>
</div>

<form method="get" asp-action="TopSuppliers" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Top</label>
            <input type="number" name="top" class="form-control form-control-sm" value="@Model.Top" min="1" max="50" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex justify-content-end">
        <span class="fw-bold">Total Purchases: @Model.TotalPurchases.ToString("N2")</span>
    </div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>#</th><th>Supplier</th><th class="text-end">Invoices</th><th class="text-end">Qty</th>
                <th class="text-end">Amount</th><th class="text-end">%</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Rank</td><td>@r.Supplier</td><td class="text-end">@r.InvoiceCount</td><td class="text-end">@r.Quantity.ToString("N2")</td>
                    <td class="text-end">@r.Amount.ToString("N2")</td><td class="text-end">@r.Percent.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">No purchases</td></tr>
            }
        </tbody>
    </table>
</div>