@model PurchaseRequest
@{
    ViewData["Title"] = "Purchase Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchase Request Details</h1>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        @if (Model.Status == PurchaseRequestStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Company</dt>
            <dd class="col-sm-4">@Model.Company?.Name</dd>
            <dt class="col-sm-2">Request No</dt>
            <dd class="col-sm-4">@Model.RequestNo</dd>
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-4">@Model.RequestDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-2">Requested By</dt>
            <dd class="col-sm-4">@Model.RequestedBy</dd>
            <dt class="col-sm-2">Branch</dt>
            <dd class="col-sm-4">@Model.Branch?.Name</dd>
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-4">@Model.Status</dd>
            <dt class="col-sm-2">Note</dt>
            <dd class="col-sm-10">@(Model.Note ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0 table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Lines.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">No lines.</td>
                    </tr>
                }
                else
                {
                    var idx = 1;
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@(idx++)</td>
                            <td>@line.Product?.Name</td>
                            <td class="text-end">@line.Quantity</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>