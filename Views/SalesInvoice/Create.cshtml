@{
    ViewData["Title"] = "New Sales Invoice";
}

<h1 class="h4 mb-3"><i class="bi bi-plus-lg"></i> New Sales Invoice</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="SalesInvoice" asp-action="Create" method="post" id="invoiceForm">
            <input type="hidden" id="customerId" name="customerId" value="" />
            <input type="hidden" id="branchId" name="branchId" value="" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Sales Order</label>
                    <select name="orderId" id="orderId" class="form-select" asp-items="ViewBag.Orders">
                        <option value="">-- Select Confirmed Order --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Invoice Date</label>
                    <input name="invoiceDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Due Date</label>
                    <input name="dueDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Warehouse (stock-out)</label>
                    <select name="warehouseId" id="warehouseId" asp-items="ViewBag.Warehouses" class="form-select">
                        <option value="">-- Select Warehouse --</option>
                    </select>
                    <div class="form-text">Product lines are deducted from this warehouse.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payment Type</label>
                    <select name="paymentType" asp-items="Html.GetEnumSelectList<SalesPaymentType>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Amount Paid</label>
                    <input name="amountPaid" type="number" step="0.01" min="0" value="0" class="form-control" />
                    <div class="form-text">Cannot exceed invoice total.</div>
                </div>
                <div class="col-12">
                    <label class="form-label">Note</label>
                    <input name="note" class="form-control" />
                </div>
            </div>

            <hr class="my-3" />
            <div id="orderSummary" class="text-muted">Select an order to preview its lines and total.</div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" id="btnSave"><i class="bi bi-check-lg"></i> Create Invoice</button>
                <a asp-controller="SalesInvoice" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    var orderId = document.getElementById('orderId');
    var summary = document.getElementById('orderSummary');

    orderId.addEventListener('change', function () {
        if (!orderId.value) {
            summary.innerHTML = '<span class="text-muted">Select an order to preview its lines and total.</span>';
            document.getElementById('customerId').value = '';
            document.getElementById('branchId').value = '';
            return;
        }
        fetch('@Url.Action("GetOrderInfo")?orderId=' + orderId.value)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.error) {
                    summary.innerHTML = '<span class="text-danger">' + data.error + '</span>';
                    return;
                }
                document.getElementById('customerId').value = data.customerId;
                document.getElementById('branchId').value = data.branchId;
                var rows = '';
                data.lines.forEach(function (l) {
                    rows += '<tr><td>' + l.name + '</td><td>' + l.type + '</td><td class="text-end">' + l.qty + '</td><td class="text-end">' + l.price + '</td><td class="text-end">' + l.amount + '</td></tr>';
                });
                summary.innerHTML =
                    '<h6 class="mb-2"><span class="badge text-bg-primary">' + data.orderNo + '</span> &mdash; ' + data.customerName + '</h6>' +
                    '<table class="table table-sm mb-2"><thead class="table-light"><tr><th>Item</th><th>Type</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Amount</th></tr></thead><tbody>' + rows +
                    '<tr class="table-active"><td colspan="4" class="text-end fw-bold">Total</td><td class="text-end fw-bold">' + data.total + '</td></tr></tbody></table>';
            });
    });
</script>