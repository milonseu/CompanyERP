@model List<CompanyERP.Entities.Sales.SalesOrder>
@{
    ViewData["Title"] = "Sales Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-bag"></i> Sales Orders</h1>
    <a asp-controller="SalesOrder" asp-action="Create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg"></i> New Sales Order
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order No</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Branch</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No sales orders found.</td></tr>
                }
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderNo</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@order.Customer?.Name</td>
                        <td>@order.Branch?.Name</td>
                        <td class="text-end">@order.Total.ToString("N2")</td>
                        <td class="text-center">
                            <span class="badge @(order.Status switch
                            {
                                SalesOrderStatus.Draft => "text-bg-secondary",
                                SalesOrderStatus.Confirmed => "text-bg-primary",
                                SalesOrderStatus.Invoiced => "text-bg-success",
                                SalesOrderStatus.Cancelled => "text-bg-danger",
                                _ => "text-bg-secondary"
                            })">@order.Status</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="SalesOrder" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (order.Status == SalesOrderStatus.Draft)
                            {
                                <a asp-controller="SalesOrder" asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-controller="SalesOrder" asp-action="Confirm" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Confirm this sales order?');">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Confirm</button>
                                </form>
                                <a asp-controller="SalesOrder" asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>