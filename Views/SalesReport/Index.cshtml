@{
    ViewData["Title"] = "Sales Reports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sales Reports</h1>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Home</a>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header"><strong>Sales</strong></div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><a asp-action="Summary">Sales Register / Summary</a></li>
                <li class="list-group-item"><a asp-action="ByProduct">Sales by Product / Category</a></li>
                <li class="list-group-item"><a asp-action="Outstanding">Outstanding Receivable vs Invoice</a></li>
                <li class="list-group-item"><a asp-action="Top">Top Customers / Products</a></li>
                <li class="list-group-item"><a asp-action="ServiceCompletion">Service Order Completion Summary</a></li>
            </ul>
        </div>
    </div>
</div>