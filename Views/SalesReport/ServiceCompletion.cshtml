@model ServiceCompletionViewModel
@{
    ViewData["Title"] = "Service Order Completion Summary";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Service Order Completion Summary</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Sales Reports</a>
</div>

<form method="get" asp-action="ServiceCompletion" class="card shadow-sm mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label">From</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">To</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-sm btn-primary">Show</button>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Pending</div><div class="fs-5 fw-bold">@Model.Pending</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">In Progress</div><div class="fs-5 fw-bold">@Model.InProgress</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Delivered</div><div class="fs-5 fw-bold">@Model.Delivered</div></div></div></div>
    <div class="col-md-3"><div class="card shadow-sm text-center"><div class="card-body"><div class="text-muted small">Cancelled</div><div class="fs-5 fw-bold">@Model.Cancelled</div></div></div></div>
</div>

<div class="card shadow-sm">
    <table class="table table-sm table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Service</th><th class="text-end">Orders</th><th class="text-end">Ordered Qty</th>
                <th class="text-end">Delivered Qty</th><th class="text-end">Amount</th><th class="text-end">Delivered %</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>@r.Service</td><td class="text-end">@r.Orders</td><td class="text-end">@r.OrderedQty.ToString("N2")</td>
                    <td class="text-end">@r.DeliveredQty.ToString("N2")</td><td class="text-end">@r.Amount.ToString("N2")</td>
                    <td class="text-end">@r.DeliveredPercent.ToString("N1")%</td>
                </tr>
            }
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">No service orders in range</td></tr>
            }
        </tbody>
    </table>
</div>