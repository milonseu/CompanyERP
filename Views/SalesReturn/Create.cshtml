@{
    ViewData["Title"] = "New Sales Return";
}

<h1 class="h4 mb-3"><i class="bi bi-plus-lg"></i> New Sales Return</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="SalesReturn" asp-action="Create" method="post" id="returnForm">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Sales Invoice</label>
                    <select name="invoiceId" id="invoiceId" asp-items="ViewBag.Invoices" class="form-select">
                        <option value="">-- Select Invoice --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Return Date</label>
                    <input name="returnDate" type="date" class="form-control" value="@ViewBag.Today" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Note</label>
                    <input name="note" class="form-control" />
                </div>
            </div>

            <hr class="my-3" />
            <h6 class="mb-2">Items to Return</h6>
            <div id="returnItems" class="text-muted">Select an invoice to load its invoice lines. Product lines are restored to stock on posting.</div>
            <div class="small text-muted mt-1">Set a quantity of zero (or blank) to exclude the line.</div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Post Return</button>
                <a asp-controller="SalesReturn" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    var orderOf = function (item) { return item.itemType + '-' + item.productId + '-' + item.serviceId; };

    function renderItems(items) {
        var box = document.getElementById('returnItems');
        var indexes = {};
        items.forEach(function (item) {
            var key = orderOf(item);
            var i = indexes[key] = Object.keys(indexes).length;
            item._idx = i;
        });
        var html = '<div class="table-responsive"><table class="table table-sm align-middle"><thead class="table-light"><tr>' +
            '<th>Item</th><th>Type</th><th class="text-end">Sold</th><th class="text-end">Already Returned</th>' +
            '<th style="width:140px;">Qty to Return</th><th style="width:150px;">Refund Price</th></tr></thead><tbody>';
        items.forEach(function (item) {
            html += '<tr>' +
                '<td>' + item.name +
                '<input type="hidden" name="lines[' + item._idx + '].ItemType" value="' + item.itemType + '" />' +
                '<input type="hidden" name="lines[' + item._idx + '].ProductId" value="' + (item.productId || '') + '" />' +
                '<input type="hidden" name="lines[' + item._idx + '].ServiceId" value="' + (item.serviceId || '') + '" />' +
                '</td>' +
                '<td>' + item.itemType + '</td>' +
                '<td class="text-end">' + item.sold + '</td>' +
                '<td class="text-end">' + (item.sold - item.available) + '</td>' +
                '<td><input type="number" step="any" min="0" max="' + item.available + '" name="lines[' + item._idx + '].Quantity" data-avail="' + item.available + '" class="form-control r-qty" /></td>' +
                '<td><input type="number" step="0.01" min="0" name="lines[' + item._idx + '].UnitPrice" value="' + item.unitPrice + '" class="form-control" /></td>' +
                '</tr>';
        });
        html += '</tbody></table></div>';
        box.innerHTML = html;
    }

    document.getElementById('invoiceId').addEventListener('change', function () {
        var id = this.value;
        var box = document.getElementById('returnItems');
        if (!id) {
            box.innerHTML = '<span class="text-muted">Select an invoice to load its invoice lines.</span>';
            return;
        }
        box.innerHTML = '<span class="text-muted">Loading...</span>';
        fetch('@Url.Action("GetInvoiceItems")?invoiceId=' + id)
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data.error) { box.innerHTML = '<span class="text-danger">' + data.error + '</span>'; return; }
                if (!data.items.length) { box.innerHTML = '<span class="text-muted">All items on this invoice have already been fully returned.</span>'; return; }
                renderItems(data.items);
            });
    });

    document.getElementById('returnForm').addEventListener('submit', function (e) {
        var rows = document.querySelectorAll('.r-qty');
        rows.forEach(function (input) {
            if (!input.value || Number(input.value) <= 0) {
                var tr = input.closest('tr');
                if (tr) { tr.remove(); }
            }
        });
    });
</script>