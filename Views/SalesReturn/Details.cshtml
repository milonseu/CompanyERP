@model CompanyERP.Entities.Sales.SalesReturn
@{
    ViewData["Title"] = "Sales Return Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-arrow-return-left"></i> Sales Return — @Model.ReturnNo</h1>
    <div>
        <a asp-controller="SalesReturn" asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
        <form asp-controller="SalesReturn" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Posted sales returns are financial records. Delete anyway?');">
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
    </div>
</div>

<div class="alert alert-info">Posted returns are financial records. Deleting them is blocked by the system. Product quantities are restocked on posting.</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="badge text-bg-primary">@Model.Status</span>
                <span class="small text-muted">@Model.SalesInvoice?.InvoiceNo</span>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Item</th>
                            <th>Type</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Refund Price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            var name = line.ItemType == SalesItemType.Product
                                ? line.Product?.Name ?? $"Product #{line.ProductId}"
                                : line.Service?.Name ?? $"Service #{line.ServiceId}";
                            <tr>
                                <td>@name</td>
                                <td><span class="badge text-bg-light">@line.ItemType</span></td>
                                <td class="text-end">@line.Quantity.ToString("N2")</td>
                                <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                                <td class="text-end">@line.Amount.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="table-active">
                            <td colspan="4" class="text-end fw-bold">Refund</td>
                            <td class="text-end fw-bold">@Model.RefundTotal.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-4">Invoice</dt>
                    <dd class="col-sm-8">@Model.SalesInvoice?.InvoiceNo</dd>
                    <dt class="col-sm-4">Customer</dt>
                    <dd class="col-sm-8">@Model.Customer?.Name</dd>
                    <dt class="col-sm-4">Branch</dt>
                    <dd class="col-sm-8">@Model.Branch?.Name</dd>
                    <dt class="col-sm-4">Return Date</dt>
                    <dd class="col-sm-8">@Model.ReturnDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-4">Note</dt>
                    <dd class="col-sm-8">@(Model.Note ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>