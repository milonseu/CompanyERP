@model List<CompanyERP.Entities.Sales.SalesReturn>
@{
    ViewData["Title"] = "Sales Returns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-arrow-return-left"></i> Sales Returns</h1>
    <a asp-controller="SalesReturn" asp-action="Create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg"></i> New Sales Return
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Return No</th>
                    <th>Date</th>
                    <th>Invoice</th>
                    <th>Customer</th>
                    <th class="text-end">Refund</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No sales returns found.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ReturnNo</td>
                        <td>@item.ReturnDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.SalesInvoice?.InvoiceNo</td>
                        <td>@item.Customer?.Name</td>
                        <td class="text-end">@item.RefundTotal.ToString("N2")</td>
                        <td class="text-center">
                            <span class="badge text-bg-primary">@item.Status</span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="SalesReturn" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>