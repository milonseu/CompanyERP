@model List<CompanyERP.Entities.Sales.ServiceDelivery>
@{
    ViewData["Title"] = "Service Deliveries";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-truck"></i> Service Deliveries</h1>
    <a asp-controller="ServiceDelivery" asp-action="Create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg"></i> Record Delivery
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Service Order</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th class="text-end">Qty</th>
                    <th>Delivered By</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No service deliveries found.</td></tr>
                }
                @foreach (var delivery in Model)
                {
                    <tr>
                        <td>@delivery.DeliveryDate.ToString("yyyy-MM-dd")</td>
                        <td>@delivery.ServiceOrder?.OrderNo</td>
                        <td>@delivery.ServiceOrder?.Customer?.Name</td>
                        <td>@delivery.ServiceOrder?.Service?.Name</td>
                        <td class="text-end">@delivery.Quantity.ToString("N2")</td>
                        <td>@(delivery.DeliveredBy ?? "-")</td>
                        <td class="text-end">
                            <a asp-controller="ServiceDelivery" asp-action="Details" asp-route-id="@delivery.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>