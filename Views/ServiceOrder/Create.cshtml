@model CompanyERP.Entities.Sales.ServiceOrder
@{
    ViewData["Title"] = "New Service Order";
}

<h1 class="h4 mb-3"><i class="bi bi-plus-lg"></i> New Service Order</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-controller="ServiceOrder" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="OrderNo" />

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Order No</label>
                    <input class="form-control" value="@Model.OrderNo" readonly />
                </div>
                <div class="col-md-3">
                    <label asp-for="OrderDate" class="form-label"></label>
                    <input asp-for="OrderDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ServiceDate" class="form-label"></label>
                    <input asp-for="ServiceDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="BranchId" class="form-label"></label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                        <option value="">-- Select Branch --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CustomerId" class="form-label"></label>
                    <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ServiceId" class="form-label"></label>
                    <select asp-for="ServiceId" asp-items="ViewBag.Services" class="form-select" id="svcSelect">
                        <option value="">-- Select Service --</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" type="number" step="any" min="0" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="UnitPrice" class="form-label"></label>
                    <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" id="svcPrice" />
                </div>
                <div class="col-md-8">
                    <label asp-for="Note" class="form-label"></label>
                    <input asp-for="Note" class="form-control" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Order</button>
                <a asp-controller="ServiceOrder" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var services = @Html.Raw(ViewBag.ServicesJson ?? "[]");
        var priceByService = {};
        services.forEach(function (s) { priceByService[s.Id] = s.UnitPrice; });
        var sel = document.getElementById('svcSelect');
        var price = document.getElementById('svcPrice');
        sel.addEventListener('change', function () {
            var v = Number(sel.value);
            if (v && priceByService[v] !== undefined) { price.value = priceByService[v]; }
        });
        if (sel.value && priceByService[Number(sel.value)] !== undefined) { price.value = priceByService[Number(sel.value)]; }
    })();
</script>