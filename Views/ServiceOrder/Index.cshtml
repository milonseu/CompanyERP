@model List<CompanyERP.Entities.Sales.ServiceOrder>
@{
    ViewData["Title"] = "Service Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-tools"></i> Service Orders</h1>
    <a asp-controller="ServiceOrder" asp-action="Create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg"></i> New Service Order
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order No</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Delivered</th>
                    <th class="text-center">Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No service orders found.</td></tr>
                }
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderNo</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td>@order.Customer?.Name</td>
                        <td>@order.Service?.Name</td>
                        <td class="text-end">@order.Quantity.ToString("N2")</td>
                        <td class="text-end">@order.Total.ToString("N2")</td>
                        <td class="text-center">@order.DeliveredQuantity.ToString("N2")</td>
                        <td class="text-center">
                            <span class="badge @(order.Status switch
                            {
                                ServiceOrderStatus.Pending => "text-bg-secondary",
                                ServiceOrderStatus.InProgress => "text-bg-info",
                                ServiceOrderStatus.Delivered => "text-bg-success",
                                ServiceOrderStatus.Cancelled => "text-bg-danger",
                                _ => "text-bg-secondary"
                            })">@order.Status</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-controller="ServiceOrder" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (order.Status == ServiceOrderStatus.Pending)
                            {
                                <form asp-controller="ServiceOrder" asp-action="Start" asp-route-id="@order.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-info">Start</button>
                                </form>
                                <a asp-controller="ServiceOrder" asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                            @if (order.Status == ServiceOrderStatus.Pending || order.Status == ServiceOrderStatus.InProgress)
                            {
                                <form asp-controller="ServiceOrder" asp-action="Cancel" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Cancel this service order?');">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>