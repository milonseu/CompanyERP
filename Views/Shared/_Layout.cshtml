@inject CompanyERP.Interfaces.Services.IUserService UserSvc
@inject CompanyERP.Interfaces.Services.IMenuService MenuSvc
@{
    var registrationOpen = !(await UserSvc.AnyUserExistsAsync());
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CompanyERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CompanyERP.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="dash-layout">
        <header class="topbar d-flex align-items-center px-3 gap-2">
            <button class="btn btn-sm btn-outline-light d-lg-none border-0" type="button" id="sidebarToggle" aria-label="Toggle sidebar">
                <i class="bi bi-list fs-4"></i>
            </button>
            <a class="topbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="topbar-brand-logo d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-building-gear"></i>
                </span>
                <span class="topbar-brand-name fw-bold">CompanyERP</span>
            </a>
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span>@User.Identity.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <span class="dropdown-item-text small text-muted">
                                    <i class="bi bi-person-badge"></i> Signed in as <strong>@User.Identity.Name</strong>
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    @if (registrationOpen)
                    {
                        <a class="topbar-link d-flex align-items-center gap-1" asp-controller="Account" asp-action="Register">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    }
                    <a class="topbar-link d-flex align-items-center gap-1" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                }
            </div>
        </header>

        <div class="side-overlay" id="sideOverlay"></div>

        <aside class="sidebar" id="siteSidebar">
            <nav class="sidebar-nav p-2">
                <ul class="list-unstyled mb-0">
                @if (User.Identity?.IsAuthenticated == true)
                {
var allMenus = await MenuSvc.GetAllAsync();
                    foreach (var parent in allMenus.Where(m => m.ParentId == null).OrderBy(m => m.DisplayOrder))
                    {
                        var effectiveChildren = allMenus
                            .Where(m => m.ParentId == parent.Id && m.IsActive)
                            .Where(m => string.IsNullOrWhiteSpace(m.PermissionCode) || User.HasPermission(m.PermissionCode))
                            .OrderBy(m => m.DisplayOrder)
                            .ToList();

                        var canSeeParent = parent.IsActive
                            && (string.IsNullOrWhiteSpace(parent.PermissionCode) || User.HasPermission(parent.PermissionCode));

                        if (effectiveChildren.Any())
                        {
                            <li>
                                <a class="side-link has-sub" data-bs-toggle="collapse" href="#collapse@(parent.Code)" role="button" aria-expanded="false">
                                    <i class="bi @(parent.Icon ?? "bi-link45deg")"></i><span>@parent.Name</span>
                                    <i class="bi bi-chevron-down ms-auto"></i>
                                </a>
                                <ul class="collapse sub-menu" id="collapse@(parent.Code)">
                                    @foreach (var child in effectiveChildren)
                                    {
                                        <li><a class="side-sub" asp-controller="@child.Controller" asp-action="@child.Action"><i class="bi @(child.Icon ?? "bi-link45deg")"></i> @child.Name</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        else if (canSeeParent && !string.IsNullOrWhiteSpace(parent.Controller))
                        {
                            <li>
                                <a class="side-link" asp-controller="@parent.Controller" asp-action="@parent.Action">
                                    <i class="bi @(parent.Icon ?? "bi-link45deg")"></i><span>@parent.Name</span>
                                </a>
                            </li>
                        }
                    }
                }
                </ul>
            </nav>
        </aside>

        <main class="content">
            <div class="container-fluid px-3 px-lg-4 py-3">
                @if (TempData["Success"] is not null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is not null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="app-footer text-muted">
        <div class="container-fluid px-3 px-lg-4">
            &copy; 2026 - CompanyERP
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            var sidebar = document.getElementById('siteSidebar');
            var overlay = document.getElementById('sideOverlay');
            var toggleBtn = document.getElementById('sidebarToggle');

            if (!sidebar || !toggleBtn) return;

            function setSidebar(open) {
                sidebar.classList.toggle('show', open);
                document.body.classList.toggle('side-open', open);
            }

            toggleBtn.addEventListener('click', function () {
                setSidebar(!sidebar.classList.contains('show'));
            });

            if (overlay) {
                overlay.addEventListener('click', function () { setSidebar(false); });
            }

            function anchorClick(e) {
                var t = e.target.closest('a.side-sub');
                if (t && window.innerWidth < 992) {
                    setSidebar(false);
                }
            }

            document.querySelector('.sidebar-nav').addEventListener('click', anchorClick);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
