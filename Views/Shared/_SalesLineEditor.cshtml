@{
    var productsJson = (string?)ViewBag.ProductsJson ?? "[]";
    var servicesJson = (string?)ViewBag.ServicesJson ?? "[]";
    var existingLinesJson = (string?)ViewBag.ExistingLinesJson ?? "[]";
}

<style>
    #salesLineEditorBody tr td { vertical-align: top; }
    .remove-line { margin-top: 30px; }
</style>

<div class="table-responsive">
    <table class="table table-sm align-middle" id="salesLineEditor" style="min-width: 760px;">
        <thead>
            <tr>
                <th style="width: 130px;">Type</th>
                <th style="min-width: 230px;">Item</th>
                <th style="width: 110px;">Quantity</th>
                <th style="width: 160px;">Unit Price</th>
                <th style="width: 80px;"></th>
            </tr>
        </thead>
        <tbody id="salesLineEditorBody"></tbody>
    </table>
</div>
<button type="button" id="btnAddSalesLine" class="btn btn-sm btn-outline-primary mb-2">+ Add Line</button>

<script>
    (function () {
        var products = @Html.Raw(productsJson);
        var services = @Html.Raw(servicesJson);
        var existingLines = @Html.Raw(existingLinesJson);
        var counter = 0;
        var body = document.getElementById('salesLineEditorBody');
        var serviceKindByService = {};
        services.forEach(function (s) { serviceKindByService[s.id] = s.serviceKind; });

        function itemTypeOptions(selected) {
            var html = '';
            [[0, 'Product'], [1, 'Software'], [2, 'Service']].forEach(function (pair) {
                html += '<option value="' + pair[0] + '"' + (selected === pair[0] ? ' selected' : '') + '>' + pair[1] + '</option>';
            });
            return html;
        }

        function productOptions(selectedId) {
            var html = '<option value="">-- Select Product --</option>';
            products.forEach(function (p) {
                html += '<option value="' + p.id + '"' + (p.id === selectedId ? ' selected' : '') + ' data-price="' + p.salePrice + '">' + p.name + '</option>';
            });
            return html;
        }

        function serviceOptions(selectedId, kind) {
            var list = kind === 0 ? 'software' : 'service';
            var html = '<option value="">-- Select ' + list + ' --</option>';
            services.forEach(function (s) {
                if (s.serviceKind === kind) {
                    html += '<option value="' + s.id + '"' + (s.id === selectedId ? ' selected' : '') + ' data-price="' + s.unitPrice + '">' + s.name + '</option>';
                }
            });
            return html;
        }

        function renderRow(line) {
            var i = counter++;
            var type = line ? line.itemType : 0;
            var productSel = productOptions(line ? line.productId : 0);
            var kind = type === 1 ? 0 : 1;
            var serviceSel = serviceOptions(line ? line.serviceId : 0, type ? kind : 1);

            var row = document.createElement('tr');
            row.innerHTML =
                '<td><select class="form-select item-type" name="lines[' + i + '].ItemType">' + itemTypeOptions(type) + '</select></td>' +
                '<td>' +
                '<select class="form-select product-select" name="lines[' + i + '].ProductId">' + productSel + '</select>' +
                '<select class="form-select service-select d-none" name="lines[' + i + '].ServiceId">' + serviceSel + '</select>' +
                '</td>' +
                '<td><input type="number" step="any" min="0" name="lines[' + i + '].Quantity" class="form-control" value="' + (line ? line.quantity : '') + '" /></td>' +
                '<td><input type="number" step="0.01" min="0" name="lines[' + i + '].UnitPrice" class="form-control" value="' + (line ? line.unitPrice : '') + '" /></td>' +
                '<td class="remove-line"><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest(\'tr\').remove();">Remove</button></td>';

            var productEl = row.querySelector('.product-select');
            var serviceEl = row.querySelector('.service-select');
            var priceEl = row.querySelector('input[name$=".UnitPrice"]');

            var setMode = function () {
                var t = Number(row.querySelector('.item-type').value);
                var isProduct = t === 0;
                productEl.classList.toggle('d-none', !isProduct);
                serviceEl.classList.toggle('d-none', isProduct);
                if (isProduct) {
                    serviceEl.value = '';
                } else {
                    var kindSel = t === 1 ? 0 : 1;
                    var current = Number(serviceEl.value) || 0;
                    serviceEl.innerHTML = serviceOptions(current, kindSel);
                }
            };

            row.querySelector('.item-type').addEventListener('change', function () {
                setMode();
                var t = Number(row.querySelector('.item-type').value);
                if (t !== 0) {
                    var s = serviceEl.options[serviceEl.selectedIndex];
                    if (s && s.dataset.price !== undefined) priceEl.value = s.dataset.price;
                }
            });

            productEl.addEventListener('change', function () {
                var s = productEl.options[productEl.selectedIndex];
                if (s && s.dataset.price !== undefined) priceEl.value = s.dataset.price;
            });

            serviceEl.addEventListener('change', function () {
                var s = serviceEl.options[serviceEl.selectedIndex];
                if (s && s.dataset.price !== undefined) priceEl.value = s.dataset.price;
            });

            setMode();
            body.appendChild(row);
        }

        document.getElementById('btnAddSalesLine').addEventListener('click', function () { renderRow(null); });

        existingLines.forEach(renderRow);
        if (existingLines.length === 0) { renderRow(null); }
    })();
</script>