@{
    ViewData["Title"] = "Statements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Customer / Supplier Statements</h1>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5"><i class="bi bi-person-lines-fill"></i> Customer Statement</h2>
                <p class="text-muted small mb-3">Invoices, payments and running balance per customer.</p>
                <a asp-action="Customer" class="btn btn-sm btn-outline-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5"><i class="bi bi-truck"></i> Supplier Statement</h2>
                <p class="text-muted small mb-3">Purchase invoices, payments and running balance per supplier.</p>
                <a asp-action="Supplier" class="btn btn-sm btn-outline-primary">Open</a>
            </div>
        </div>
    </div>
</div>