@model CompanyERP.Entities.Supplier.Supplier
@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete Supplier</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <div class="alert alert-warning">
            Are you sure you want to delete supplier <strong>@Model.Name</strong> (@Model.SupplierCode)? Contacts and addresses will also be removed.
        </div>
        <dl class="row mb-3">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.Name</dd>

            <dt class="col-sm-3">Supplier Code</dt>
            <dd class="col-sm-9">@Model.SupplierCode</dd>

            <dt class="col-sm-3">Supplier Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Opening Payable</dt>
            <dd class="col-sm-9">@Model.OpeningPayable.ToString("N2")</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>