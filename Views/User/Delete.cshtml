@model CompanyERP.Entities.Security.User
@{
    ViewData["Title"] = "Delete User";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delete User</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm border-danger">
    <div class="card-body">
        <div class="alert alert-danger">
            Are you sure you want to delete <strong>@Model.UserName</strong>? This action cannot be undone.
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">User Name</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@(Model.FullName ?? "-")</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "-")</dd>
        </dl>

        @if (Model.IsSystem)
        {
            <div class="alert alert-warning mt-3 mb-0">
                This is a system account and cannot be deleted.
            </div>
        }

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger" @(Model.IsSystem ? "disabled" : "")>Delete</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>