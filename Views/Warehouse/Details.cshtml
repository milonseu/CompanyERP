@model CompanyERP.Entities.Inventory.Warehouse
@{
    ViewData["Title"] = "Warehouse Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Company</dt>
            <dd class="col-sm-9">@Model.Company?.Name</dd>
            <dt class="col-sm-3">Branch</dt>
            <dd class="col-sm-9">@Model.Branch?.Name</dd>
            <dt class="col-sm-3">Warehouse Code</dt>
            <dd class="col-sm-9"><span class="badge bg-light text-dark">@Model.Code</span></dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@(Model.Address ?? "-")</dd>
            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>
        <div class="mt-4 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        </div>
    </div>
</div>